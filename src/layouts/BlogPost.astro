---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type BlogPostData = CollectionEntry<'blog'>['data'];

interface Props extends BlogPostData {
  postSlug?: string;
}

const { title, description, pubDate, updatedDate, hold, postSlug, photo, photoAlt, photoPosition } = Astro.props as Props;

const sectionRoutes: Record<string, { title: string; href: string }> = {
  'training-the-mind': {
    title: 'Training the Mind',
    href: '/content-hub/training-the-mind/',
  },
  'gael-performance-toolkit': {
    title: 'Gael Performance Toolkit',
    href: '/content-hub/gael-performance-toolkit/',
  },
  'strong-minds-stronger-players': {
    title: 'Strong Minds, Stronger Players',
    href: '/content-hub/strong-minds-stronger-players/',
  },
  'mindfulness-and-affirmations': {
    title: 'Mindfulness & Affirmations',
    href: '/content-hub/mindfulness-and-affirmations/',
  },
};

const sectionSlug = postSlug?.split('/')[0];
const sectionMeta = sectionSlug ? sectionRoutes[sectionSlug] : undefined;
const isGaelToolkitPost = sectionSlug === 'gael-performance-toolkit';
const isMindfulnessPost = sectionSlug === 'mindfulness-and-affirmations';

// Every article is free to read. The only gate left is the release schedule,
// and it now applies to all four series, not just SMSP. It used to be SMSP
// only, which meant a Training the Mind or Toolkit article that was locked on
// its hub card still opened in full if you had the URL.
//
// Two things lock an article: a pubDate that has not arrived, or an editorial
// hold. A held article has no date worth showing, so the gate says "coming
// soon" rather than naming a day nobody intends to keep.
const today = new Date();
today.setUTCHours(0, 0, 0, 0);

const releaseDateLabel = pubDate.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const bypassGatesInDev = import.meta.env.DEV;
const isHeldBack = hold === true;
const showComingSoonGate = (isHeldBack || pubDate > today) && !bypassGatesInDev;
const contentIsLocked = showComingSoonGate;

const showToolkitToolsBox = sectionSlug === 'training-the-mind';

---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body class:list={["blog-post-page", isGaelToolkitPost && "gael-toolkit-post", isMindfulnessPost && "mindfulness-post", (isGaelToolkitPost || isMindfulnessPost) && "interactive-post"]}>
    <Header />

    <a href="#article-main" class="skip-link">Skip to content</a>
    <main id="article-main" class="container article-main">
      <section class="article-hero">
        <p class="article-kicker">Content Hub Article</p>
        <h1>{title}</h1>
        <div class="article-meta">
          <p>
            Published <FormattedDate date={pubDate} />
          </p>
          {updatedDate && (
            <p>
              Updated <FormattedDate date={updatedDate} />
            </p>
          )}
          {sectionMeta && (
            <p>
              <a href={sectionMeta.href} class="section-link">Back to {sectionMeta.title}</a>
            </p>
          )}
        </div>

        {/* Read aloud. Hidden until the script confirms the browser can speak,
            so it is never a button that does nothing, and not rendered at all
            on a locked article since there is nothing to read yet. */}
        {!contentIsLocked && (
          <div class="listen-bar" id="listen-bar" hidden>
            <button type="button" class="listen-btn" id="listen-toggle" aria-describedby="listen-note">
              <span class="listen-icon" aria-hidden="true">&#9654;</span>
              <span class="listen-label" id="listen-label">Listen to this article</span>
            </button>
            <button type="button" class="listen-stop" id="listen-stop" hidden>Stop</button>
            <p class="listen-note" id="listen-note">Read aloud by your device. The voice and quality depend on your browser.</p>
            <p class="listen-status" id="listen-status" role="status" aria-live="polite"></p>
          </div>
        )}
      </section>

      {photo && (
        <figure class="article-photo">
          <img
            src={photo}
            alt={photoAlt ?? ""}
            loading="lazy"
            style={photoPosition ? `object-position: ${photoPosition};` : undefined}
          />
        </figure>
      )}

      <article class="article-shell">
        {showComingSoonGate && (
          <div class="coming-soon-gate">
            <p class="coming-soon-eyebrow">{isHeldBack ? 'Coming soon' : `Releases ${releaseDateLabel}`}</p>
            <h2>This one is not out yet</h2>
            <p>
              {isHeldBack
                ? 'This piece is being reworked before it goes out. Every article on Mind the Gael is free, so nothing is behind a payment here. It will appear on the series page as soon as it is ready.'
                : `This one lands on ${releaseDateLabel}. Every article on Mind the Gael is free, so nothing is behind a payment here. Check back on the day.`}
            </p>
            {sectionMeta && (
              <a href={sectionMeta.href} class="gate-cta gate-cta-back">Back to {sectionMeta.title}</a>
            )}
          </div>
        )}

        <div id="paid-content" class:list={["paid-content prose", contentIsLocked && "is-locked"]}>
          <slot />

          {showToolkitToolsBox && (
            <section class="toolkit-tools-box" aria-label="Related practical tools">
              <p class="toolkit-tools-title">Looking for practical tools to use this in real matches?</p>
              <p class="toolkit-tools-copy">Go to the Gael Performance Toolkit for practical tools related to this article.</p>
              <a href="/content-hub/gael-performance-toolkit/" class="toolkit-tools-link">Open Gael Performance Toolkit</a>
            </section>
          )}

          <section class="content-feedback-link-box">
            <p>Have feedback on this content?</p>
            <a href="/content-feedback" class="content-feedback-link">Share feedback</a>
          </section>
        </div>
      </article>
    </main>

    <Footer />

    <script is:inline define:vars={{ isGaelToolkitPost, isMindfulnessPost, isLocalPreview: bypassGatesInDev, deckLede: description }}>
      window.addEventListener('DOMContentLoaded', () => {
        const paidContent = document.getElementById('paid-content');
        const toolkitToolsBox = paidContent?.querySelector('.toolkit-tools-box');

        // Page furniture that must stay on the page, not get swept into a
        // card by the "move everything up to the next h2" loops below. The
        // references dropdown is built before those loops run, so it is no
        // longer an h2 and nothing else stops them consuming it.
        const isPageFurniture = (node) =>
          node.nodeType === Node.ELEMENT_NODE &&
          (node.classList.contains('refs-details') ||
            node.classList.contains('content-feedback-link-box') ||
            node.classList.contains('toolkit-tools-box'));

        // References collapse into a dropdown. They are the least-read part
        // of the page but still need to be there, so they are present and
        // citable without taking up half the article.
        if (paidContent) {
          const refHeading = Array.from(paidContent.querySelectorAll('h2, h3')).find(
            (h) => (h.textContent || '').trim().toLowerCase() === 'references'
          );
          if (refHeading) {
            const details = document.createElement('details');
            details.className = 'refs-details';
            const summary = document.createElement('summary');
            summary.className = 'refs-summary';
            const body = document.createElement('div');
            body.className = 'refs-body';

            // Move everything after the heading into the dropdown body.
            let node = refHeading.nextSibling;
            const moved = [];
            while (node) {
              if (node.nodeType === Node.ELEMENT_NODE && /^H[123]$/.test(node.tagName)) break;
              moved.push(node);
              node = node.nextSibling;
            }
            refHeading.parentNode.insertBefore(details, refHeading);
            moved.forEach((n) => body.appendChild(n));

            const count = body.querySelectorAll('li').length;
            summary.textContent = count ? `References (${count})` : 'References';
            details.appendChild(summary);
            details.appendChild(body);
            refHeading.remove();
          }
        }


        // The "ADD YOUR EXPERIENCE HERE" blockquotes are editing prompts for
        // Emily. They render while running locally so she can see exactly
        // where to write, and are stripped in production so readers never
        // see them.
        if (paidContent) {
          const prompts = Array.from(paidContent.querySelectorAll('blockquote')).filter((bq) =>
            (bq.textContent || '').includes('ADD YOUR EXPERIENCE HERE')
          );
          prompts.forEach((bq) => {
            if (isLocalPreview) {
              bq.classList.add('experience-prompt');
            } else {
              bq.remove();
            }
          });
        }


        if (paidContent && isGaelToolkitPost) {
          const headings = Array.from(paidContent.querySelectorAll('h2'));
          const toolHeadings = headings.filter((heading) => {
            const text = heading.textContent?.trim().toLowerCase() || '';
            return text.startsWith('tool ');
          });

          // Anything that is neither a tool nor the references list, which in
          // practice is the "Putting it together" section every toolkit ends
          // with. It moves onto the green card below the tiles, as writing
          // rather than as another tile: it is the summary of the tools, so a
          // tile of its own would read as a sixth tool.
          const extraHeadings = headings.filter((heading) => {
            const text = heading.textContent?.trim().toLowerCase() || '';
            return !text.startsWith('tool ') && text !== 'references';
          });

          toolHeadings.forEach((heading) => {
            const card = document.createElement('section');
            card.className = 'toolkit-tool-card';
            heading.parentNode?.insertBefore(card, heading);
            card.appendChild(heading);

            let node = card.nextSibling;
            while (node) {
              if (node.nodeType === Node.ELEMENT_NODE) {
                const el = node;
                if (el.tagName === 'H2' || isPageFurniture(el)) break;
              }
              const next = node.nextSibling;
              card.appendChild(node);
              node = next;
            }
          });

          // Turn each tool card into a compact tile that pops its content
          // open in a dialog. Toolkits are reference material you dip into
          // mid-week, so a wall of five tools is a lot to scroll; a grid of
          // tappable tiles is quicker to scan and more inviting to use.
          // The full content stays in the DOM, so it is still indexable and
          // still readable if this script never runs.
          const toolCards = Array.from(paidContent.querySelectorAll('.toolkit-tool-card'));

          // ── TOOLKIT: numbered tiles on a card ──────────────────────────
          // Tools render as an index of numbered tiles on a single pale
          // green card, matching the Toolkit template. Tapping a tile opens
          // the full tool in a dialog. This replaced a cloud of floating
          // bubbles, which looked good but gave no reliable reading order
          // and sized tools differently for no reason a reader could see.
          if (toolCards.length > 0) {
            const shell = document.createElement('section');
            shell.className = 'deck-card deck-card-toolkit';
            shell.innerHTML =
              '<div class="deck-head deck-head-toolkit">' +
                '<img class="deck-logo" src="/assets/MTG_colour.png" alt="" aria-hidden="true" />' +
                '<div class="deck-head-centre">' +
                  '<p class="deck-eyebrow">Practical resources</p>' +
                  '<p class="deck-series">Toolkit</p>' +
                '</div>' +
              '</div>' +
              '<div class="tool-tiles"></div>' +
              '<div class="deck-foot"><span class="deck-count"></span></div>';
            // Counts tools only. "Putting it together" is a tile too, but it
            // is a summary of the tools rather than one of them, so counting
            // it would overstate what the toolkit contains.
            const toolCount = toolCards.filter((c) =>
              /^tool\s/i.test((c.querySelector('h2')?.textContent || '').trim())
            ).length;
            shell.querySelector('.deck-count').textContent =
              toolCount + (toolCount === 1 ? ' tool' : ' tools');

            const cloud = shell.querySelector('.tool-tiles');
            toolCards[0].parentNode.insertBefore(shell, toolCards[0]);

            // A native <dialog> opened with showModal(), rather than a div
            // with role="dialog". The browser then traps focus, handles
            // Escape, and hides the rest of the page from assistive tech,
            // none of which a div can do on its own.
            const sheet = document.createElement('dialog');
            sheet.className = 'tool-sheet';
            sheet.innerHTML =
              '<div class="tool-sheet-panel">' +
                '<button type="button" class="tool-sheet-close" aria-label="Close">Done</button>' +
                '<div class="tool-sheet-body"></div>' +
              '</div>';
            document.body.appendChild(sheet);
            const sheetBody = sheet.querySelector('.tool-sheet-body');

            // Focus moves into the sheet when it opens and returns to the
            // bubble that opened it when it closes, so keyboard and screen
            // reader users are not stranded behind the overlay.
            const closeSheet = () => {
              if (sheet.open) sheet.close();
            };
            // Native dialog restores focus to the opener on close.
            sheet.addEventListener("close", () => {
              document.body.classList.remove("sheet-open");
            });
            sheet.querySelector('.tool-sheet-close').addEventListener('click', closeSheet);
            sheet.addEventListener('click', (e) => { if (e.target === sheet) closeSheet(); });

            toolCards.forEach((card, i) => {
              const heading = card.querySelector('h2');
              const raw = (heading?.textContent || 'Tool ' + (i + 1)).trim();
              const m = raw.match(/^Tool\s*(\d+)\s*[:.–-]?\s*(.*)$/i);
              const num = m ? m[1] : String(i + 1);
              const name = m && m[2] ? m[2] : raw;
              const key = 'tool-' + num;

              const bubble = document.createElement('button');
              bubble.type = 'button';
              bubble.className = 'tool-tile';
              bubble.dataset.key = key;
              // Two digits, so 01 sits at the same width as 10 and the tile
              // names all start on the same vertical line.
              bubble.innerHTML =
                '<span class="tool-tile-num">' + String(num).padStart(2, '0') + '</span>' +
                '<span class="tool-tile-name"></span>';
              bubble.querySelector('.tool-tile-name').textContent = name;

              bubble.addEventListener('click', () => {
                sheetBody.innerHTML = '';
                // The source card carries .tool-card-collapsed (display:none)
                // to hide it on the page. The clone must not, or the sheet
                // opens empty.
                const clone = card.cloneNode(true);
                clone.classList.remove('tool-card-collapsed');
                sheetBody.appendChild(clone);
                sheet.showModal();
                document.body.classList.add("sheet-open");
                sheet.querySelector(".tool-sheet-close").focus();
              });

              cloud.appendChild(bubble);
              card.classList.add('tool-card-collapsed');
            });

            // "Putting it together" and anything like it: moved onto the
            // card under the tiles, as plain writing. Nodes are moved rather
            // than copied, so nothing is left behind on the page below.
            if (extraHeadings.length > 0) {
              const extra = document.createElement('div');
              extra.className = 'deck-extra';
              extraHeadings.forEach((heading) => {
                let node = heading.nextSibling;
                extra.appendChild(heading);
                while (node) {
                  if (node.nodeType === Node.ELEMENT_NODE && (node.tagName === 'H2' || isPageFurniture(node))) break;
                  const next = node.nextSibling;
                  extra.appendChild(node);
                  node = next;
                }
              });
              shell.insertBefore(extra, shell.querySelector('.deck-foot'));
            }
          }
        }

        // Mindfulness posts open as a swipeable slide deck, like flicking
        // through a social post. Each "## " section becomes one slide. The
        // full article stays in the page underneath, so it is still
        // readable, linkable and indexable if the deck never opens.
        // Mindfulness posts ARE a slide deck. Each "## " section becomes a
        // slide and the nodes are moved (not copied) into it, so the article
        // renders as the deck rather than offering a deck as an extra. The
        // content stays in the DOM, so it is still indexable and linkable.
        // ── MINDFULNESS: story-style cards ───────────────────────────────
        // Built to read like a social story rather than an article: one
        // section per card, segmented progress bar along the top, tap the
        // right or left half to move, swipe on touch, arrow keys on desktop.
        // Nodes are moved (not cloned) so the page IS the story and the text
        // stays indexable.
        if (paidContent && isMindfulnessPost) {
          const headings = Array.from(paidContent.querySelectorAll('h2'))
            .filter((h) => (h.textContent || '').trim().toLowerCase() !== 'references');

          if (headings.length > 1) {
            const story = document.createElement('div');
            story.className = 'story';
            story.innerHTML =
              '<div class="story-bars" role="tablist"></div>' +
              '<div class="story-stage"></div>' +
              '<button type="button" class="story-zone story-zone-prev" aria-label="Previous"></button>' +
              '<button type="button" class="story-zone story-zone-next" aria-label="Next"></button>' +
              '<div class="story-foot">' +
                '<span class="story-count"></span>' +
                '<span class="story-hint">Tap either side, or swipe</span>' +
              '</div>';
            headings[0].parentNode.insertBefore(story, headings[0]);

            const stage = story.querySelector('.story-stage');
            const bars = story.querySelector('.story-bars');
            const countEl = story.querySelector('.story-count');
            const total = headings.length;

            headings.forEach((heading, i) => {
              const card = document.createElement('section');
              card.className = 'story-card deck-card deck-card-mindfulness';
              let node = heading.nextSibling;
              card.appendChild(heading);
              while (node) {
                if (node.nodeType === Node.ELEMENT_NODE && (node.tagName === 'H2' || isPageFurniture(node))) break;
                const next = node.nextSibling;
                card.appendChild(node);
                node = next;
              }

              // Logo and title above the card body, so every card is
              // self-contained if it gets screenshotted and shared, which is
              // how these actually travel. The card's own h2 becomes the
              // title and "Mindfulness" drops to an eyebrow above it: a big
              // "Mindfulness" repeated on all six cards told you nothing
              // about which card you were looking at.
              //
              // A div, not a <header>. global.css styles the site header by
              // element name, which paints any <header> on the page black.
              const head = document.createElement('div');
              head.className = 'deck-head deck-head-mindfulness';
              head.innerHTML =
                '<img class="deck-logo" src="/assets/MTG_colour.png" alt="" aria-hidden="true" />' +
                '<p class="deck-eyebrow">Mindfulness</p>' +
                '<h2 class="deck-series"></h2>';
              head.querySelector('.deck-series').textContent = (heading.textContent || '').trim();
              // The heading is now the card title in the head, so the
              // original would render it a second time.
              heading.remove();
              card.insertBefore(head, card.firstChild);

              // Two or more h3 subsections become side-by-side columns, the
              // way the template lays out Values against In the moment. One
              // subsection stays full width: a single narrow column next to
              // an empty half is worse than no columns at all.
              const subs = Array.from(card.querySelectorAll(':scope > h3'));
              if (subs.length >= 2) {
                const grid = document.createElement('div');
                grid.className = 'deck-cols';
                subs.forEach((sub) => {
                  const col = document.createElement('div');
                  col.className = 'deck-col';
                  let n = sub.nextSibling;
                  col.appendChild(sub);
                  while (n) {
                    if (n.nodeType === Node.ELEMENT_NODE && n.tagName === 'H3') break;
                    const next = n.nextSibling;
                    col.appendChild(n);
                    n = next;
                  }
                  grid.appendChild(col);
                });
                card.appendChild(grid);
              }

              stage.appendChild(card);

              const bar = document.createElement('button');
              bar.type = 'button';
              bar.className = 'story-bar';
              bar.setAttribute('aria-label', 'Card ' + (i + 1) + ' of ' + total);
              bar.addEventListener('click', (e) => { e.stopPropagation(); go(i); });
              bars.appendChild(bar);
            });

            let index = 0;
            const cards = Array.from(stage.querySelectorAll('.story-card'));

            function go(i) {
              index = (i + total) % total;
              cards.forEach((c, n) => c.classList.toggle('is-active', n === index));
              Array.from(bars.children).forEach((b, n) => {
                b.classList.toggle('is-done', n < index);
                b.classList.toggle('is-active', n === index);
              });
              countEl.textContent = (index + 1) + ' of ' + total;
            }

            story.querySelector('.story-zone-next').addEventListener('click', () => go(index + 1));
            story.querySelector('.story-zone-prev').addEventListener('click', () => go(index - 1));

            story.addEventListener('keydown', (e) => {
              if (e.key === 'ArrowRight') { e.preventDefault(); go(index + 1); }
              if (e.key === 'ArrowLeft') { e.preventDefault(); go(index - 1); }
            });
            story.tabIndex = 0;

            // Touch swipe.
            let startX = null;
            story.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; }, { passive: true });
            story.addEventListener('touchend', (e) => {
              if (startX === null) return;
              const dx = e.changedTouches[0].clientX - startX;
              if (Math.abs(dx) > 45) go(index + (dx < 0 ? 1 : -1));
              startX = null;
            });

            go(0);
          }
        }

        if (paidContent && toolkitToolsBox) {
          const referencesHeading = Array.from(paidContent.querySelectorAll('h2, h3')).find((heading) =>
            heading.textContent?.trim().toLowerCase() === 'references'
          );

          if (referencesHeading) {
            paidContent.insertBefore(toolkitToolsBox, referencesHeading);
          }
        }

        // Style the paragraph immediately before the References heading as a
        // purple banner IF it contains a link to the Gael Performance Toolkit.
        // The wording of this paragraph varies across posts ("Practical tools
        // in...", "Practical tools at...", etc.); matching by position +
        // toolkit link is more robust than matching by text.
        if (paidContent) {
          const referencesHeading = Array.from(paidContent.querySelectorAll('h2, h3')).find((heading) =>
            (heading.textContent || '').trim().toLowerCase() === 'references'
          );
          if (referencesHeading) {
            let prev = referencesHeading.previousElementSibling;
            while (prev && prev.tagName !== 'P') {
              prev = prev.previousElementSibling;
            }
            if (prev && prev.tagName === 'P') {
              const link = prev.querySelector('a[href*="/gael-performance-toolkit/"]');
              if (link) {
                prev.classList.add('practical-tools-banner');
              }
            }
          }
        }

      });
    </script>

    <script is:inline>
      // ── Read aloud ────────────────────────────────────────────────────
      // Uses the browser's own speech engine (Web Speech API). No API key,
      // no per-article cost, no build step, and it works offline on devices
      // that ship voices locally. The trade-off is voice quality: it is
      // whatever the reader's OS provides, which is decent on iOS and macOS
      // and noticeably robotic on some Android and Windows setups. That is
      // the reason for the note under the button.
      window.addEventListener('DOMContentLoaded', () => {
        const bar = document.getElementById('listen-bar');
        if (!bar) return;

        const synth = window.speechSynthesis;
        // Feature-detect before revealing the control. Firefox on some
        // platforms exposes speechSynthesis with no voices at all.
        if (!synth || typeof SpeechSynthesisUtterance === 'undefined') return;

        const toggle = document.getElementById('listen-toggle');
        const stopBtn = document.getElementById('listen-stop');
        const label = document.getElementById('listen-label');
        const icon = toggle.querySelector('.listen-icon');
        const status = document.getElementById('listen-status');
        const source = document.getElementById('paid-content');
        if (!source) return;

        // What gets read, in reading order. Headings are included so the
        // structure survives being listened to rather than looked at, and
        // the feedback box and references dropdown are skipped because they
        // are page furniture, not the article.
        //
        // Toolkit tools are read even though their cards are visually
        // collapsed into tiles: the text is the article, and someone
        // listening cannot tap a tile open.
        const SKIP = ['.content-feedback-link-box', '.toolkit-tools-box', '.refs-details', '.listen-bar'];
        const collect = () => {
          const parts = [];
          source.querySelectorAll('h1, h2, h3, h4, p, li, blockquote').forEach((node) => {
            if (SKIP.some((sel) => node.closest(sel))) return;
            const text = (node.textContent || '').replace(/\s+/g, ' ').trim();
            if (text) parts.push(text);
          });
          return parts;
        };

        // Chunked rather than one long utterance. Chrome truncates or stalls
        // on very long strings, so each block is queued separately and the
        // queue is what carries progress. Blocks are further split on
        // sentence boundaries when they are long on their own.
        const chunk = (parts) => {
          const out = [];
          parts.forEach((part) => {
            if (part.length <= 220) { out.push(part); return; }
            let buffer = '';
            part.split(/(?<=[.!?])\s+/).forEach((sentence) => {
              if ((buffer + ' ' + sentence).trim().length > 220) {
                if (buffer) out.push(buffer.trim());
                buffer = sentence;
              } else {
                buffer = (buffer + ' ' + sentence).trim();
              }
            });
            if (buffer) out.push(buffer.trim());
          });
          return out;
        };

        // Prefer a British or Irish voice, since the writing is Irish. Voices
        // load asynchronously in Chrome, hence the voiceschanged listener.
        let voice = null;
        const pickVoice = () => {
          const voices = synth.getVoices();
          if (!voices.length) return;
          voice =
            voices.find((v) => v.lang === 'en-IE') ||
            voices.find((v) => v.lang === 'en-GB') ||
            voices.find((v) => v.lang && v.lang.startsWith('en')) ||
            voices[0];
        };
        pickVoice();
        if (typeof synth.addEventListener === 'function') {
          synth.addEventListener('voiceschanged', pickVoice);
        }

        let queue = [];
        let index = 0;
        let playing = false;

        const setUI = (state) => {
          if (state === 'playing') {
            icon.innerHTML = '&#10074;&#10074;';
            label.textContent = 'Pause';
            stopBtn.hidden = false;
          } else if (state === 'paused') {
            icon.innerHTML = '&#9654;';
            label.textContent = 'Resume';
            stopBtn.hidden = false;
          } else {
            icon.innerHTML = '&#9654;';
            label.textContent = 'Listen to this article';
            stopBtn.hidden = true;
            status.textContent = '';
          }
        };

        const reset = () => {
          synth.cancel();
          queue = [];
          index = 0;
          playing = false;
          setUI('idle');
        };

        const speakNext = () => {
          if (index >= queue.length) {
            reset();
            return;
          }
          const utterance = new SpeechSynthesisUtterance(queue[index]);
          if (voice) {
            utterance.voice = voice;
            utterance.lang = voice.lang;
          }
          utterance.rate = 1;
          utterance.onend = () => {
            if (!playing) return;
            index += 1;
            status.textContent = `Part ${Math.min(index + 1, queue.length)} of ${queue.length}`;
            speakNext();
          };
          // A failed utterance must not stall the whole article, so it moves
          // on rather than sitting there looking like it is still playing.
          utterance.onerror = () => {
            if (!playing) return;
            index += 1;
            speakNext();
          };
          synth.speak(utterance);
        };

        toggle.addEventListener('click', () => {
          if (!playing) {
            queue = chunk(collect());
            if (!queue.length) return;
            index = 0;
            playing = true;
            setUI('playing');
            status.textContent = `Part 1 of ${queue.length}`;
            // Cancel first: an utterance left over from a previous page in
            // the same tab otherwise plays over the top of this one.
            synth.cancel();
            speakNext();
          } else if (synth.paused) {
            synth.resume();
            setUI('playing');
          } else {
            synth.pause();
            setUI('paused');
          }
        });

        stopBtn.addEventListener('click', reset);

        // Speech keeps going after navigation in several browsers, so it is
        // cancelled on the way out. pagehide rather than beforeunload,
        // because Safari does not reliably fire beforeunload on mobile.
        window.addEventListener('pagehide', () => synth.cancel());

        bar.hidden = false;
      });
    </script>
  </body>
</html>

