---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type BlogPostData = CollectionEntry<'blog'>['data'];

interface Props extends BlogPostData {
  postSlug?: string;
}

const { title, description, pubDate, updatedDate, postSlug } = Astro.props as Props;

const sectionRoutes: Record<string, { title: string; href: string }> = {
  'training-the-mind': {
    title: 'Training the Mind',
    href: '/content-hub/training-the-mind/',
  },
  'gael-performance-toolkit': {
    title: 'Gael Performance Toolkit',
    href: '/content-hub/gael-performance-toolkit/',
  },
  'strong-minds-stronger-players': {
    title: 'Strong Minds, Stronger Players',
    href: '/content-hub/strong-minds-stronger-players/',
  },
  'mindfulness-and-affirmations': {
    title: 'Mindfulness & Affirmations',
    href: '/content-hub/mindfulness-and-affirmations/',
  },
};

const sectionSlug = postSlug?.split('/')[0];
const sectionMeta = sectionSlug ? sectionRoutes[sectionSlug] : undefined;
const isGaelToolkitPost = sectionSlug === 'gael-performance-toolkit';
const isMindfulnessPost = sectionSlug === 'mindfulness-and-affirmations';
const isSmspPost = sectionSlug === 'strong-minds-stronger-players';

// Every article is free to read. The only gate left is the SMSP release
// schedule: an SMSP post whose pubDate has not arrived yet shows a
// "releases on" notice instead of its content. This is a schedule, not a
// paywall. Training the Mind and Gael Performance Toolkit articles have no
// gate on the article page (their release schedule is enforced on the hub).
const today = new Date();
today.setUTCHours(0, 0, 0, 0);

const releaseDateLabel = pubDate.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const bypassGatesInDev = import.meta.env.DEV;
const showComingSoonGate = isSmspPost && pubDate > today && !bypassGatesInDev;
const contentIsLocked = showComingSoonGate;

const showToolkitToolsBox = sectionSlug === 'training-the-mind';

---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body class:list={["blog-post-page", isGaelToolkitPost && "gael-toolkit-post"]}>
    <Header />

    <main class="container article-main">
      <section class="article-hero">
        <p class="article-kicker">Content Hub Article</p>
        <h1>{title}</h1>
        <div class="article-meta">
          <p>
            Published <FormattedDate date={pubDate} />
          </p>
          {updatedDate && (
            <p>
              Updated <FormattedDate date={updatedDate} />
            </p>
          )}
          {sectionMeta && (
            <p>
              <a href={sectionMeta.href} class="section-link">Back to {sectionMeta.title}</a>
            </p>
          )}
        </div>
      </section>

      <article class="article-shell">
        {showComingSoonGate && (
          <div class="coming-soon-gate">
            <p class="coming-soon-eyebrow">Releases {releaseDateLabel}</p>
            <h2>This one is not out yet</h2>
            <p>Strong Minds, Stronger Players releases one post a month, and this one lands on {releaseDateLabel}. The whole series is always free for every player and coach, so there is nothing to buy. Check back on the day.</p>
            <a href="/content-hub/strong-minds-stronger-players/" class="gate-cta gate-cta-back">Back to the series</a>
          </div>
        )}

        <div id="paid-content" class:list={["paid-content prose", contentIsLocked && "is-locked"]}>
          <slot />

          {showToolkitToolsBox && (
            <section class="toolkit-tools-box" aria-label="Related practical tools">
              <p class="toolkit-tools-title">Looking for practical tools to use this in real matches?</p>
              <p class="toolkit-tools-copy">Go to the Gael Performance Toolkit for practical tools related to this article.</p>
              <a href="/content-hub/gael-performance-toolkit/" class="toolkit-tools-link">Open Gael Performance Toolkit</a>
            </section>
          )}

          <section class="content-feedback-link-box">
            <p>Have feedback on this content?</p>
            <a href="/content-feedback" class="content-feedback-link">Share feedback</a>
          </section>
        </div>
      </article>
    </main>

    <Footer />

    <script is:inline define:vars={{ isGaelToolkitPost, isMindfulnessPost }}>
      window.addEventListener('DOMContentLoaded', () => {
        const paidContent = document.getElementById('paid-content');
        const toolkitToolsBox = paidContent?.querySelector('.toolkit-tools-box');

        if (paidContent && isGaelToolkitPost) {
          const headings = Array.from(paidContent.querySelectorAll('h2'));
          const toolHeadings = headings.filter((heading) => {
            const text = heading.textContent?.trim().toLowerCase() || '';
            return text.startsWith('tool ');
          });

          toolHeadings.forEach((heading) => {
            const card = document.createElement('section');
            card.className = 'toolkit-tool-card';
            heading.parentNode?.insertBefore(card, heading);
            card.appendChild(heading);

            let node = card.nextSibling;
            while (node) {
              if (node.nodeType === Node.ELEMENT_NODE) {
                const el = node;
                if (el.tagName === 'H2') break;
              }
              const next = node.nextSibling;
              card.appendChild(node);
              node = next;
            }
          });

          // Turn each tool card into a compact tile that pops its content
          // open in a dialog. Toolkits are reference material you dip into
          // mid-week, so a wall of five tools is a lot to scroll; a grid of
          // tappable tiles is quicker to scan and more inviting to use.
          // The full content stays in the DOM, so it is still indexable and
          // still readable if this script never runs.
          const toolCards = Array.from(paidContent.querySelectorAll('.toolkit-tool-card'));

          if (toolCards.length > 1) {
            const grid = document.createElement('div');
            grid.className = 'tool-tile-grid';
            toolCards[0].parentNode?.insertBefore(grid, toolCards[0]);

            const dialog = document.createElement('dialog');
            dialog.className = 'tool-dialog';
            const dialogInner = document.createElement('div');
            dialogInner.className = 'tool-dialog-inner';
            const closeBtn = document.createElement('button');
            closeBtn.type = 'button';
            closeBtn.className = 'tool-dialog-close';
            closeBtn.setAttribute('aria-label', 'Close');
            closeBtn.textContent = '×';
            const dialogBody = document.createElement('div');
            dialogBody.className = 'tool-dialog-body';
            dialogInner.appendChild(closeBtn);
            dialogInner.appendChild(dialogBody);
            dialog.appendChild(dialogInner);
            document.body.appendChild(dialog);

            const closeDialog = () => {
              if (dialog.open) dialog.close();
            };
            closeBtn.addEventListener('click', closeDialog);
            // Clicking the backdrop (outside the inner panel) closes it too.
            dialog.addEventListener('click', (event) => {
              if (event.target === dialog) closeDialog();
            });

            toolCards.forEach((card, index) => {
              const cardHeading = card.querySelector('h2');
              const rawTitle = (cardHeading?.textContent || `Tool ${index + 1}`).trim();
              // "Tool 3: The Specific Visualisation" -> number + name, so the
              // tile can show them on separate lines.
              const match = rawTitle.match(/^Tool\s*(\d+)\s*[:.–-]?\s*(.*)$/i);
              const number = match ? match[1] : String(index + 1);
              const name = match && match[2] ? match[2] : rawTitle;

              const tile = document.createElement('button');
              tile.type = 'button';
              tile.className = 'tool-tile';
              tile.innerHTML =
                '<span class="tool-tile-num">Tool ' + number + '</span>' +
                '<span class="tool-tile-name"></span>' +
                '<span class="tool-tile-cta">Open →</span>';
              const nameEl = tile.querySelector('.tool-tile-name');
              if (nameEl) nameEl.textContent = name;

              tile.addEventListener('click', () => {
                dialogBody.innerHTML = '';
                // Clone so the original stays in the document for SEO and
                // for the no-JS reading order.
                dialogBody.appendChild(card.cloneNode(true));
                dialog.showModal();
              });

              grid.appendChild(tile);
              card.classList.add('tool-card-collapsed');
            });
          }
        }

        // Mindfulness posts open as a swipeable slide deck, like flicking
        // through a social post. Each "## " section becomes one slide. The
        // full article stays in the page underneath, so it is still
        // readable, linkable and indexable if the deck never opens.
        // Mindfulness posts ARE a slide deck. Each "## " section becomes a
        // slide and the nodes are moved (not copied) into it, so the article
        // renders as the deck rather than offering a deck as an extra. The
        // content stays in the DOM, so it is still indexable and linkable.
        if (paidContent && isMindfulnessPost) {
          const headings = Array.from(paidContent.querySelectorAll('h2'))
            .filter((h) => (h.textContent || '').trim().toLowerCase() !== 'references');

          if (headings.length > 1) {
            const deck = document.createElement('div');
            deck.className = 'deck-inline';
            deck.innerHTML =
              '<div class="deck-track"></div>' +
              '<div class="deck-foot">' +
                '<button type="button" class="deck-prev" aria-label="Previous slide">‹</button>' +
                '<div class="deck-dots"></div>' +
                '<button type="button" class="deck-next" aria-label="Next slide">›</button>' +
              '</div>';
            headings[0].parentNode.insertBefore(deck, headings[0]);

            const track = deck.querySelector('.deck-track');
            const dots = deck.querySelector('.deck-dots');

            headings.forEach((heading, i) => {
              const slide = document.createElement('section');
              slide.className = 'deck-slide';
              const count = document.createElement('span');
              count.className = 'deck-count';
              count.textContent = (i + 1) + ' / ' + headings.length;
              slide.appendChild(count);

              // Move the heading and everything up to the next h2 into the slide.
              let node = heading.nextSibling;
              slide.appendChild(heading);
              while (node) {
                if (node.nodeType === Node.ELEMENT_NODE && node.tagName === 'H2') break;
                const next = node.nextSibling;
                slide.appendChild(node);
                node = next;
              }
              track.appendChild(slide);

              const dot = document.createElement('button');
              dot.type = 'button';
              dot.className = 'deck-dot';
              dot.setAttribute('aria-label', 'Go to slide ' + (i + 1));
              dot.addEventListener('click', () => go(i));
              dots.appendChild(dot);
            });

            let index = 0;
            const go = (i) => {
              index = Math.max(0, Math.min(headings.length - 1, i));
              track.scrollTo({ left: track.clientWidth * index, behavior: 'smooth' });
              sync();
            };
            const sync = () => {
              Array.from(dots.children).forEach((d, i) =>
                d.classList.toggle('is-active', i === index)
              );
              deck.querySelector('.deck-prev').disabled = index === 0;
              deck.querySelector('.deck-next').disabled = index === headings.length - 1;
            };

            deck.querySelector('.deck-prev').addEventListener('click', () => go(index - 1));
            deck.querySelector('.deck-next').addEventListener('click', () => go(index + 1));

            let raf = null;
            track.addEventListener('scroll', () => {
              if (raf) cancelAnimationFrame(raf);
              raf = requestAnimationFrame(() => {
                const i = Math.round(track.scrollLeft / track.clientWidth);
                if (i !== index) { index = i; sync(); }
              });
            });

            sync();
          }
        }

        if (paidContent && toolkitToolsBox) {
          const referencesHeading = Array.from(paidContent.querySelectorAll('h2, h3')).find((heading) =>
            heading.textContent?.trim().toLowerCase() === 'references'
          );

          if (referencesHeading) {
            paidContent.insertBefore(toolkitToolsBox, referencesHeading);
          }
        }

        // Style the paragraph immediately before the References heading as a
        // purple banner IF it contains a link to the Gael Performance Toolkit.
        // The wording of this paragraph varies across posts ("Practical tools
        // in...", "Practical tools at...", etc.); matching by position +
        // toolkit link is more robust than matching by text.
        if (paidContent) {
          const referencesHeading = Array.from(paidContent.querySelectorAll('h2, h3')).find((heading) =>
            (heading.textContent || '').trim().toLowerCase() === 'references'
          );
          if (referencesHeading) {
            let prev = referencesHeading.previousElementSibling;
            while (prev && prev.tagName !== 'P') {
              prev = prev.previousElementSibling;
            }
            if (prev && prev.tagName === 'P') {
              const link = prev.querySelector('a[href*="/gael-performance-toolkit/"]');
              if (link) {
                prev.classList.add('practical-tools-banner');
              }
            }
          }
        }

      });
    </script>
  </body>
</html>

<style>
  .article-main {
    width: 900px;
    max-width: calc(100% - 2em);
    padding-top: 0;
    padding-bottom: 3rem;
  }

  .article-hero {
    margin: 0 calc(50% - 50vw) 1rem;
    padding: 2rem max(1rem, calc(50vw - 450px + 1rem));
    background: linear-gradient(180deg, rgba(3, 10, 6, 0.95) 0%, rgba(3, 10, 6, 0.82) 100%);
  }

  .article-kicker {
    margin: 0;
    color: var(--purple-light);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.74rem;
    font-weight: 700;
  }

  .article-hero h1 {
    margin: 0.25rem 0 0.5rem;
    color: var(--green-lime);
  }

  .article-meta {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  .article-meta p {
    margin: 0;
    font-size: 0.85rem;
    color: var(--green-light);
  }

  .section-link {
    color: #ffffff !important;
    font-weight: 700;
    text-decoration: underline !important;
  }

  .section-link:hover {
    color: var(--green-lime) !important;
  }

  .article-shell {
    border: 1px solid rgba(105, 0, 90, 0.24);
    border-radius: 12px;
    background: #ffffff;
    padding: 1.1rem;
  }

  /* Release-date notice for SMSP posts whose pubDate has not arrived. */
  .coming-soon-gate {
    margin: 0 0 1.2rem;
    padding: 1.25rem 1.1rem;
    border: 2px solid var(--green-lime);
    border-radius: 12px;
    background: rgba(192, 254, 113, 0.12);
    text-align: center;
  }

  .coming-soon-gate .coming-soon-eyebrow {
    margin: 0 0 0.4rem;
    color: var(--green-lime);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.78rem;
    font-weight: 800;
  }

  .coming-soon-gate h2 {
    margin: 0 0 0.6rem;
    color: var(--purple);
    font-size: 1.25rem;
  }

  .coming-soon-gate p {
    margin: 0 auto 0.5rem;
    max-width: 56ch;
    color: var(--green-dark);
  }

  .coming-soon-gate .gate-cta-back {
    margin-top: 0.85rem;
    background: transparent;
    border-color: var(--purple);
    color: var(--purple) !important;
  }

  .coming-soon-gate .gate-cta-back:hover {
    background: var(--purple);
    color: #ffffff !important;
    border-color: var(--purple);
  }

  .gate-cta {
    display: inline-block;
    margin-top: 0.7rem;
    padding: 0.5rem 0.95rem;
    border-radius: 8px;
    background: var(--green-lime);
    color: var(--green-dark) !important;
    text-decoration: none !important;
    font-weight: 700;
    border: 2px solid var(--green-lime);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .gate-cta:hover {
    transform: translateY(-1px);
    border-color: var(--purple-light);
  }


  .paid-content {
    color: var(--green-dark);
  }

  .paid-content.is-locked {
    max-height: 240px;
    overflow: hidden;
    filter: blur(1.5px);
    pointer-events: none;
    user-select: none;
    opacity: 0.72;
  }

  .prose :global(p),
  .prose :global(li),
  .prose :global(ol),
  .prose :global(ul),
  .prose :global(blockquote) {
    color: var(--green-dark);
  }

  .prose :global(p) {
    margin: 0 0 0.8rem;
    line-height: 1.55;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.25rem;
    margin-left: 0.25rem;
    margin-top: 0.25rem;
    margin-bottom: 0.8rem;
  }

  .prose :global(li) {
    padding-left: 0.2rem;
    margin-bottom: 0.2rem;
  }

  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4) {
    color: var(--purple);
    line-height: 1.3;
  }

  .prose :global(h2) {
    margin-top: 1rem;
    margin-bottom: 0.35rem;
  }

  .gael-toolkit-post .prose :global(.toolkit-tool-card) {
    border: 2px solid var(--green-lime);
    border-left: 6px solid var(--purple);
    border-radius: 12px;
    padding: 1.25rem 1.3rem 1.4rem;
    background: var(--green-light);
    box-shadow: 0 14px 32px rgba(0, 0, 0, 0.16);
    margin: 2rem 0;
}

  .gael-toolkit-post .prose :global(.toolkit-tool-card h2) {
    margin-top: 0;
    margin-bottom: 0.5rem;
    color: var(--green-dark);
    font-size: 1.25rem;
  }

  .prose :global(.practical-tools-banner) {
    background: var(--purple);
    color: var(--green-light);
    border-radius: 12px;
    padding: 1rem 1.25rem;
    margin: 1.4rem 0;
    font-weight: 600;
    box-shadow: 0 8px 20px rgba(105, 0, 90, 0.25);
  }

  .prose :global(.practical-tools-banner a) {
    color: var(--green-lime) !important;
    text-decoration: underline;
    font-weight: 700;
  }

  .prose :global(.practical-tools-banner a:hover) {
    color: #ffffff !important;
  }

  .gael-toolkit-post .prose :global(.toolkit-tool-card p:last-child),
  .gael-toolkit-post .prose :global(.toolkit-tool-card ul:last-child),
  .gael-toolkit-post .prose :global(.toolkit-tool-card ol:last-child) {
    margin-bottom: 0;
  }

  .prose :global(h3) {
    margin-top: 0.85rem;
    margin-bottom: 0.3rem;
  }

  .prose :global(h4) {
    margin-top: 0.75rem;
    margin-bottom: 0.25rem;
  }

  .prose :global(blockquote) {
    margin: 0.75rem 0;
  }

  .prose :global(a) {
    color: #4f0044 !important;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .prose :global(a:hover) {
    color: #2e0028 !important;
  }

  .content-feedback-link-box {
    margin-top: 1.2rem;
    padding: 0.9rem;
    border: 1px solid rgba(105, 0, 90, 0.5);
    border-radius: 10px;
    background: rgba(244, 255, 232, 0.95);
  }

  .content-feedback-link-box p {
    margin: 0 0 0.45rem;
    color: var(--green-dark);
  }

  .content-feedback-link {
    display: inline-block;
    text-decoration: none !important;
    border: 2px solid var(--green-lime);
    border-radius: 8px;
    padding: 0.4rem 0.8rem;
    background: var(--green-lime);
    color: var(--green-dark) !important;
    font-weight: 700;
  }

  .content-feedback-link:hover {
    border-color: var(--purple-light);
  }

  .toolkit-tools-box {
    margin-top: 1.2rem;
    padding: 0.9rem;
    border: 1px solid rgba(105, 0, 90, 0.5);
    border-radius: 10px;
    background: rgba(240, 205, 255, 0.55);
  }

  .toolkit-tools-title {
    margin: 0 0 0.45rem;
    color: var(--purple);
    font-weight: 700;
  }

  .toolkit-tools-copy {
    margin: 0 0 0.6rem;
    color: var(--green-dark);
  }

  .toolkit-tools-link {
    display: inline-block;
    text-decoration: none !important;
    border: 2px solid var(--green-lime);
    border-radius: 8px;
    padding: 0.4rem 0.8rem;
    background: var(--green-lime);
    color: var(--green-dark) !important;
    font-weight: 700;
  }

  .toolkit-tools-link:hover {
    border-color: var(--purple-light);
  }

  @media (max-width: 720px) {
    .article-main {
      width: 100%;
      max-width: 100%;
      padding-bottom: 2rem;
    }

    .article-hero {
      padding: 1.4rem max(0.85rem, calc(50vw - 450px + 1rem));
      margin-bottom: 0.9rem;
    }

    .article-shell {
      padding: 0.9rem;
    }
  }
  .prose :global(.shamrock-banner) {
  display: flex;
  align-items: flex-start;
  gap: 0.9rem;
  background: rgba(192, 254, 113, 0.18);
  border-left: 4px solid var(--green-lime);
  border-radius: 10px;
  padding: 1.1rem 1.3rem;
  margin: 1.4rem 0;
}

.prose :global(.shamrock-banner .shamrock-icon) {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 2.1rem;
  height: 2.1rem;
  border-radius: 50%;
  background: rgba(192, 254, 113, 0.35);
  border: 2px solid var(--green-lime);
  overflow: hidden;
}

.prose :global(.shamrock-banner .shamrock-icon img) {
  width: 65%;
  height: 65%;
  object-fit: contain;
}

.prose :global(.shamrock-banner-purple) {
  display: flex;
  align-items: flex-start;
  gap: 0.9rem;
  background: var(--purple);
  border-left: 4px solid var(--green-lime);
  border-radius: 10px;
  padding: 1.1rem 1.3rem;
  margin: 1.4rem 0;
}

.prose :global(.shamrock-banner-purple .shamrock-icon) {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 2.1rem;
  height: 2.1rem;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
  border: 2px solid var(--green-lime);
  overflow: hidden;
}

.prose :global(.shamrock-banner-purple .shamrock-icon img) {
  width: 65%;
  height: 65%;
  object-fit: contain;
}

.prose :global(.shamrock-banner-purple p) {
  margin: 0 0 0.4rem;
  color: var(--green-light);
}

.prose :global(.shamrock-banner-purple p:last-child) {
  margin-bottom: 0;
}

.prose :global(.shamrock-banner-purple strong) {
  color: var(--green-lime);
}
.prose :global(.visually-hidden) {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
}
</style>
<!-- The tool tiles and the pop-out dialog are created in JavaScript, and
     the dialog is appended to document.body, so Astro scoped styles cannot
     reach them. These have to be global. -->
<style is:global>
  /* Tool tiles + pop-out dialog. The underlying .toolkit-tool-card content
     stays in the DOM (hidden) so the page still works without JavaScript
     and search engines still see the full text. */
  .tool-tile-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 0.85rem;
    margin: 1.25rem 0 1.75rem;
  }

  .tool-tile {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.3rem;
    padding: 0.95rem 1rem 1rem;
    border: 2px solid var(--purple);
    border-radius: 14px;
    background: #ffffff;
    cursor: pointer;
    text-align: left;
    font: inherit;
    transition: transform 0.16s ease, box-shadow 0.16s ease, background-color 0.16s ease;
  }

