---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { SITE_TITLE } from '../consts';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
}

// ✅ SAFE SITE HANDLING
const site = Astro.site?.toString() ?? "https://mindthegael.co.uk";

const canonicalURL = new URL(Astro.url.pathname, site);

const { title, description, image } = Astro.props;
const fallbackImageUrl = '/assets/MTG_colour.png';
const imageUrl = typeof image === 'string' ? image : (image?.src || fallbackImageUrl);
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />

<!-- Rosario: the logo wordmark font. Loaded site-wide so the homepage hero
     and any future logo-styled headings can use it. -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Rosario:wght@400;700;900&display=swap" rel="stylesheet" />

<link rel="sitemap" href="/sitemap-index.xml" />

<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={new URL('rss.xml', site)}
/>

<meta name="generator" content={Astro.generator} />

<script is:inline>
  // The site could open part-way down the page, or at the very bottom, rather
  // than at the hero. That is the browser restoring the scroll position it
  // remembered for the URL, which it does on a reload and on a fresh visit to
  // a page you have been to before.
  //
  // Three things are deliberately left alone:
  //   - Back and forward. Restoring your place is the right behaviour there;
  //     returning from an article to a long series page should land you where
  //     you left, not at the top.
  //   - A real #hash target, so the skip link and the homepage's in-page
  //     links still jump where they are supposed to.
  //   - A reader who has already started scrolling before the page finished
  //     loading. Yanking them back to the top would be worse than the bug.
  (() => {
    const entry = performance.getEntriesByType('navigation')[0];
    if ((entry ? entry.type : 'navigate') === 'back_forward') return;
    if (window.location.hash) return;

    if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
    window.scrollTo(0, 0);

    // Again after load, because the restore can land after scripts have run.
    let moved = false;
    const mark = () => { moved = true; };
    addEventListener('wheel', mark, { passive: true, once: true });
    addEventListener('touchstart', mark, { passive: true, once: true });
    addEventListener('keydown', mark, { once: true });
    addEventListener('load', () => { if (!moved) window.scrollTo(0, 0); }, { once: true });
  })();
</script>

<link rel="canonical" href={canonicalURL} />

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(imageUrl, site)} />

<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(imageUrl, site)} />