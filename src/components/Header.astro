---
import { Image } from 'astro:assets';
import HeaderLink from './HeaderLink.astro';
import mtgLogo from '../assets/MTG_colour.png';
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';

// The back arrow originally called history.back(), which sent you to whatever
// you happened to be on before, not to where the page sits in the site. It was
// then changed to derive a parent from the URL, which is predictable but wrong
// in the common case: an article reached from the homepage sent you to its
// series hub, which is not where you came from.
//
// So there are two layers now. This one is the fallback, rendered into the
// href: the structural parent of the current page, which is always a sensible
// destination and is what someone arriving from a search result or a shared
// link should get. The script below upgrades it to the actual page you came
// from, but only when that page is one of the site's real entry points.
const path = Astro.url.pathname.replace(/\/+$/, '');
const segments = path.split('/').filter(Boolean);

let backHref = '/';
let backLabel = 'Back to home';

if (segments[0] === 'content-hub') {
  if (segments.length > 2) {
    // /content-hub/<series>/<article> -> the series hub
    backHref = `/content-hub/${segments[1]}/`;
    backLabel = 'Back to the series';
  } else if (segments.length === 2) {
    // /content-hub/<series> -> the content hub index
    backHref = '/content-hub/';
    backLabel = 'Back to the Content Hub';
  }
} else if (segments[0] === 'plan') {
  // /plan/<id> -> the dashboard it was opened from. The plan page used to
  // carry its own "Back to Dashboard" link as well as this bubble, which put
  // two back arrows on the page.
  backHref = '/dashboard';
  backLabel = 'Back to your dashboard';
}
---
<header id="site-header" class:list={[!isHome && 'has-back-bubble']}>
  <div class="header-inner">
    <a href="/" class="header-logo-link" aria-label="Mind the Gael home">
      <Image src={mtgLogo} alt="Mind the Gael logo" loading="eager" fetchpriority="high" />
    </a>
    <button
      type="button"
      class="nav-toggle"
      id="nav-toggle"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="primary-nav"
    >
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
    </button>
    <nav class="nav-links" id="primary-nav">
      <HeaderLink href="/">Home</HeaderLink>
      <HeaderLink href="/about">Player Stories</HeaderLink>
      <HeaderLink href="/content-hub">Content Hub</HeaderLink>
      <HeaderLink href="/books-and-podcasts">Books &amp; Podcasts</HeaderLink>
      <HeaderLink href="/personal-training">Performance Plans</HeaderLink>
      <HeaderLink href="/pricing">Pricing</HeaderLink>
      <HeaderLink href="/resources">Support Resources</HeaderLink>
      <HeaderLink href="/contact-us">Contact Us</HeaderLink>
      <a href="/login" id="nav-auth-link" class="nav-auth-link">Log In</a>
    </nav>
  </div>
  {!isHome && (
    <a href={backHref} id="back-bubble" class="back-bubble" aria-label={backLabel}>
      <span aria-hidden="true">←</span>
    </a>
  )}
</header>

<script is:inline>
  // Point the back arrow at the page you actually arrived from, when that
  // page is one of the site's entry points. Deliberately an allowlist rather
  // than "just use the referrer": coming from an article, a checkout step or
  // an external site, the structural parent already rendered into the href is
  // the better destination, and following an arbitrary referrer is how you end
  // up sending someone back into a form they already submitted.
  //
  // Inline and standalone, not part of the module below, so it cannot be held
  // up behind that module's auth await.
  (() => {
    const bubble = document.getElementById('back-bubble');
    if (!bubble || !document.referrer) return;

    let from;
    try {
      from = new URL(document.referrer);
    } catch {
      return;
    }
    if (from.origin !== window.location.origin) return;

    const trim = (p) => p.replace(/\/+$/, '') || '/';
    const fromPath = trim(from.pathname);
    if (fromPath === trim(window.location.pathname)) return;

    const segments = fromPath.split('/').filter(Boolean);
    let label = null;
    if (fromPath === '/') label = 'Back to home';
    else if (segments[0] === 'dashboard') label = 'Back to your dashboard';
    else if (segments[0] === 'content-hub') {
      if (segments.length === 1) label = 'Back to the Content Hub';
      else if (segments.length === 2) label = 'Back to the series';
    }
    if (!label) return;

    bubble.setAttribute('href', from.pathname);
    bubble.setAttribute('aria-label', label);
  })();
</script>

<script>
  import { getUserOrThrow } from '../lib/supabase.js';

  // Mobile hamburger toggle: flips the nav open/closed and updates
  // aria-expanded for screen readers. Closes when a link inside the
  // drawer is tapped so the page navigation feels seamless.
  //
  // Wired up first, before anything async. This used to sit below an
  // `await supabase.auth.getUser()`. A top-level await that never settles
  // stops the whole module, so any stall in that auth call meant these
  // listeners were never attached and the burger button rendered but did
  // nothing, on every page of the site. Navigation must not depend on
  // auth resolving.
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('nav-toggle');
  const primaryNav = document.getElementById('primary-nav');

  function closeNav() {
    if (!header || !toggle) return;
    header.classList.remove('nav-open');
    toggle.setAttribute('aria-expanded', 'false');
    toggle.setAttribute('aria-label', 'Open menu');
  }
  function openNav() {
    if (!header || !toggle) return;
    header.classList.add('nav-open');
    toggle.setAttribute('aria-expanded', 'true');
    toggle.setAttribute('aria-label', 'Close menu');
  }

  toggle?.addEventListener('click', () => {
    if (header?.classList.contains('nav-open')) closeNav();
    else openNav();
  });

  primaryNav?.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => closeNav());
  });

  // Auth state last, and deliberately non-fatal. getUserOrThrow times out
  // rather than hanging forever, and the catch keeps a failure contained:
  // the worst case is the link still reads "Log In" while you are signed
  // in, which is a cosmetic problem. The menu keeps working either way.
  const authLink = document.getElementById('nav-auth-link');
  try {
    const user = await getUserOrThrow();
    if (user && authLink) {
      authLink.textContent = 'Dashboard';
      authLink.setAttribute('href', '/dashboard');
    }
  } catch (err) {
    console.error('header auth check failed:', err);
  }
</script>

<style>
  .nav-auth-link {
    color: var(--green-lime) !important;
    text-decoration: none;
    font-size: 0.93rem;
    font-weight: 700;
    padding: 0.5em 0;
    border-bottom: 4px solid transparent;
    white-space: nowrap;
    transition: color 0.15s ease;
  }

  .nav-auth-link:hover {
    color: var(--purple-light) !important;
  }

  .header-inner {
    position: relative;
  }

  .header-logo-link {
    display: inline-flex;
    align-items: center;
    line-height: 0;
  }

  /* Hamburger button — hidden on desktop, shown on mobile. */
  .nav-toggle {
    display: none;
    width: 42px;
    height: 42px;
    padding: 0;
    background: transparent;
    border: 2px solid var(--green-lime);
    border-radius: 8px;
    cursor: pointer;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 5px;
  }

  .nav-toggle-bar {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--green-lime);
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  /* Animate to an X when open. */
  header.nav-open .nav-toggle-bar:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  header.nav-open .nav-toggle-bar:nth-child(2) { opacity: 0; }
  header.nav-open .nav-toggle-bar:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .back-bubble {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none !important;
    position: fixed;
    top: 96px;
    left: 18px;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--green-lime);
    color: var(--green-dark);
    border: 2px solid var(--green-lime);
    font: inherit;
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 1;
    cursor: pointer;
    z-index: 2500;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.28);
    transition: transform 0.15s ease, background-color 0.15s ease, border-color 0.15s ease;
  }

  .back-bubble:hover {
    transform: translateY(-2px);
    background: var(--purple-light);
    border-color: var(--purple-light);
  }

  .back-bubble span {
    display: inline-block;
    line-height: 1;
    transform: translateY(-1px);
  }

  @media (max-width: 720px) {
    /* On desktop the bubble floats over the tall header, clear of the page.
       The mobile header is far shorter, so a fixed bubble lands on top of
       the page heading instead. Give it its own strip at the bottom of the
       header so it sits above the heading rather than over it. */
    #site-header.has-back-bubble {
      position: relative;
      padding-bottom: 52px;
    }

    .back-bubble {
      position: absolute;
      top: auto;
      bottom: 8px;
      left: 12px;
      width: 36px;
      height: 36px;
      font-size: 1.05rem;
      /* Below the nav drawer (z-index 1500) so an open menu covers it. */
      z-index: 1200;
    }

    .nav-toggle {
      display: inline-flex;
    }
  }
</style>