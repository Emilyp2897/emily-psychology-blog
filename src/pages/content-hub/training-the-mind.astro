---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { trainingTheMindSeries } from '../../data/series';

// Rendered on demand rather than at build time. The scheduled-release locks
// below compare pubDate against "now", so a prerendered page would freeze
// that comparison at build time and a post would stay locked until the next
// deploy instead of unlocking on its release date.
export const prerender = false;

const allPosts = await getCollection('blog');

// Scheduled-release helper. Posts with a pubDate in the future render as
// locked cards (blurred preview, release date shown, no link) until the
// release date passes. Computed at request time so the lock lifts
// automatically without a redeploy.
// Normalised in UTC, not local time. Frontmatter dates like "2026-09-16" parse as
// UTC midnight, so normalising to LOCAL midnight puts "today" an hour behind
// during BST and a post dated today stays locked until 01:00.
const today = new Date();
today.setUTCHours(0, 0, 0, 0);

const isUnreleased = (date: Date) => date > today;

// Locked cards keep their locked appearance when running locally, but gain a
// preview link so unreleased drafts can be reviewed on the real page without
// typing URLs by hand. Never rendered in production.
const previewUnlocked = import.meta.env.DEV;

const releaseDateLabel = (date: Date) =>
  date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

const monthlySeries = trainingTheMindSeries;

function postFor(slug: string) {
  return allPosts.find((post) => post.slug === slug);
}

// Split the series into what you can read now and what is still scheduled.
// Series order is preserved inside each half; only the two halves are
// separated. Without this, a live theme can end up stranded below eight
// locked ones (championship sat under every locked theme from 2 to 9).
const groupHasReleased = (entry: (typeof monthlySeries)[number]) =>
  entry.slugs.some((slug) => {
    const post = postFor(slug);
    return post !== undefined && !isUnreleased(post.data.pubDate);
  });

const seriesSections = [
  { key: 'now', title: 'Available now', groups: monthlySeries.filter(groupHasReleased) },
  { key: 'soon', title: 'Coming up', groups: monthlySeries.filter((e) => !groupHasReleased(e)) },
].filter((section) => section.groups.length > 0);

// Next post still to be released, for the schedule box. Picks the earliest
// unreleased pubDate rather than the first unreleased post in series order,
// because the two are not always the same (Month 1 has two posts sharing a
// date, and series order does not strictly follow date order).
// Ties are real: Month 1 has two posts sharing 2026-08-01, so fall back to
// the order they appear in on the page to keep the result deterministic.
const seriesOrder = new Map(
  monthlySeries.flatMap((entry) => entry.slugs).map((slug, index) => [slug, index] as const)
);

const nextRelease = allPosts
  .filter((post) => seriesOrder.has(post.slug) && isUnreleased(post.data.pubDate))
  .sort(
    (a, b) =>
      a.data.pubDate.valueOf() - b.data.pubDate.valueOf() ||
      (seriesOrder.get(a.slug) ?? 0) - (seriesOrder.get(b.slug) ?? 0)
  )[0];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Training the Mind | ${SITE_TITLE}`} description="A 12-month journey through the mental side of sport, built for female athletes." />
  </head>
  <body class="ttm-page">
    <Header />
    <main class="container ttm-main">
      <section class="hero">
        <p class="hero-kicker">Content Hub Series</p>
        <h1>Training the Mind</h1>
        <p class="hero-tagline">Sports psychology in language that makes sense on the pitch.</p>
      </section>

      <div class="series-lead">
        <img src="/assets/saoirse.png" alt="" class="saoirse-avatar" aria-hidden="true" />
        <div class="saoirse-bubble">
        <p class="series-lead-copy">Each theme is covered twice: once to understand what is actually going on, once to apply it in real Gaelic football situations. Every post has a companion toolkit.</p>
        </div>
      </div>

      <section class="ttm-series" aria-label="Series posts">
        {seriesSections.map((section) => (
        <div class:list={["series-section", `series-section-${section.key}`]}>
          <h2 class="series-section-heading">{section.title}</h2>
          {section.groups.map((entry) => (
          <div class="month-group">
            <h3 class="month-heading">{entry.theme}</h3>
            <ul class="month-list">
              {entry.slugs.map((slug) => {
                const post = postFor(slug);
                if (!post) {
                  return (
                    <li class="ttm-card ttm-card-missing">
                      <span class="ttm-status">Coming soon</span>
                      <h4 class="ttm-title">{slug.split('/').pop()?.replace(/-/g, ' ')}</h4>
                    </li>
                  );
                }
                if (isUnreleased(post.data.pubDate)) {
                  return (
                    <li class="ttm-card ttm-card-locked" aria-disabled="true">
                      <span class="ttm-lock-badge">🔒 Releases {releaseDateLabel(post.data.pubDate)}</span>
                      <h4 class="ttm-title">{post.data.title}</h4>
                      {post.data.description && (
                        <p class="ttm-description ttm-description-blur">{post.data.description}</p>
                      )}
                      {previewUnlocked && (
                        <a class="preview-link" href={`/content-hub/${post.slug}/`}>Preview draft (local only) →</a>
                      )}
                    </li>
                  );
                }
                return (
                  <li class="ttm-card">
                    <a href={`/content-hub/${post.slug}/`}>
                      <h4 class="ttm-title">{post.data.title}</h4>
                      {post.data.description && (
                        <p class="ttm-description">{post.data.description}</p>
                      )}
                      <span class="ttm-cta">Read post →</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
          ))}
        </div>
        ))}
      </section>

      <section class="content-feedback-cta" aria-label="Content feedback">
        <p>Got feedback on this content?</p>
        <a href="/content-feedback" class="feedback-cta-link">Share feedback</a>
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  /* Saoirse introduces each series. Replaces a white card stacked on a
     bordered banner, which read as two grey boxes before you reached any
     content. She "says" the intro, with the schedule as pills underneath. */
  .series-lead {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    margin: 0 0 1.75rem;
  }

  .saoirse-avatar {
    flex: 0 0 auto;
    width: 78px;
    height: 78px;
    object-fit: contain;
    margin-top: 0.4rem;
    animation: saoirse-bob 3.2s ease-in-out infinite;
  }

  @keyframes saoirse-bob {
    0%, 100% { transform: translateY(0) rotate(-3deg); }
    50%      { transform: translateY(-6px) rotate(3deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .saoirse-avatar { animation: none; }
  }

  .saoirse-bubble {
    position: relative;
    flex: 1 1 auto;
    padding: 1.1rem 1.25rem;
    background: #ffffff;
    border: 3px solid var(--purple);
    border-radius: 18px;
    box-shadow: 0 8px 0 rgba(105, 0, 90, 0.18);
  }

  /* Tail pointing back at Saoirse. Two triangles so it gets a border too. */
  .saoirse-bubble::before,
  .saoirse-bubble::after {
    content: "";
    position: absolute;
    top: 24px;
    width: 0;
    height: 0;
    border-style: solid;
  }

  .saoirse-bubble::before {
    left: -16px;
    border-width: 10px 16px 10px 0;
    border-color: transparent var(--purple) transparent transparent;
  }

  .saoirse-bubble::after {
    left: -11px;
    border-width: 7px 12px 7px 0;
    border-color: transparent #ffffff transparent transparent;
  }

  .series-lead-copy {
    margin: 0 0 0.8rem;
    color: var(--green-dark);
    font-size: 1.05rem;
    line-height: 1.55;
  }

  .series-lead-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0;
  }

  .lead-pill {
    display: inline-block;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    border: 2px solid var(--purple);
    color: var(--purple);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .lead-pill-free {
    background: var(--green-lime);
    border-color: var(--green-lime);
    color: var(--green-dark);
    font-weight: 800;
  }

  @media (max-width: 720px) {
    .saoirse-avatar { width: 54px; height: 54px; }
    .saoirse-bubble { padding: 0.9rem 1rem; }
    .series-lead-copy { font-size: 0.98rem; }
  }

  .ttm-main {
    padding-top: 0;
    padding-bottom: 3rem;
  }

  .hero {
    margin: 0 calc(50% - 50vw) 0.8rem;
    padding: 2rem max(1rem, calc(50vw - 600px + 1rem));
    background: linear-gradient(180deg, rgba(3, 10, 6, 0.95) 0%, rgba(3, 10, 6, 0.82) 100%);
  }

  .hero-kicker {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.75rem;
    color: var(--purple-light);
    font-weight: 700;
  }

  .hero h1 {
    margin: 0.2rem 0 0;
    color: var(--green-lime);
  }

  .hero-tagline {
    margin: 0.35rem 0 0;
    color: var(--green-light);
    max-width: 64ch;
  }

  /* White intro box and lime release-schedule box, matching the pattern on
     the Strong Minds, Stronger Players page. */
  .intro-card {
    background: #ffffff;
    border: 2px solid rgba(105, 0, 90, 0.22);
    border-radius: 8px;
    padding: 1.5rem;
    margin-bottom: 1rem;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.12);
    color: #000000;
  }

  .intro-card p {
    color: #000000;
    margin: 0;
  }

  .release-schedule-banner {
    margin-bottom: 1rem;
    padding: 1.1rem 1.25rem;
    background: rgba(192, 254, 113, 0.12);
    border: 2px solid var(--green-lime);
    border-radius: 10px;
    text-align: center;
  }

  .release-eyebrow {
    margin: 0 0 0.3rem;
    color: var(--green-lime);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.78rem;
    font-weight: 800;
  }

  .release-body {
    margin: 0;
    color: var(--green-light);
    line-height: 1.5;
  }

  .ttm-series {
    margin-top: 0.4rem;
    margin-bottom: 1.6rem;
  }

  /* "Available now" / "Coming up" split. Keeps the live themes at the top so
     championship is not stranded below the locked ones. */
  .series-section {
    margin-bottom: 2rem;
  }

  .series-section-heading {
    margin: 0 0 0.75rem;
    padding-bottom: 0.4rem;
    border-bottom: 2px solid var(--green-lime);
    color: var(--green-lime);
    font-size: 1.3rem;
  }

  .series-section-soon .series-section-heading {
    border-bottom-color: rgba(192, 254, 113, 0.35);
    opacity: 0.85;
  }

  .month-group {
    margin-top: 1rem;
  }

  .month-heading {
    color: var(--purple-light);
    margin: 0 0 0.5rem;
    font-size: 1.15rem;
    font-weight: 700;
  }

  .month-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }

  /* White cards with dark titles. */
  .ttm-card {
    border: 2px solid rgba(105, 0, 90, 0.18);
    border-radius: 12px;
    padding: 1rem 1.1rem 1.1rem;
    background: #ffffff;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  /* Static on hover: no lift, no border or colour shift. */
  .ttm-card:hover {
    transform: none;
  }

  .ttm-card a {
    display: block;
    text-decoration: none !important;
    color: inherit !important;
  }

  .ttm-status {
    display: inline-block;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    background: var(--purple);
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 0.45rem;
  }

  .ttm-title {
    color: var(--green-dark) !important;
    font-size: 1.05rem;
    margin: 0 0 0.4rem;
    line-height: 1.35;
    font-weight: 700;
  }

  .ttm-description {
    color: var(--green-dark);
    font-size: 0.92rem;
    margin: 0 0 0.7rem;
    line-height: 1.5;
    opacity: 0.82;
  }

  .ttm-cta {
    color: var(--purple);
    font-weight: 700;
    font-size: 0.85rem;
  }

  .ttm-card-missing {
    opacity: 0.65;
    background: #f7f5f8;
  }

  /* Scheduled-release lock: post pubDate is in the future. Card is shown
     in muted form with a release-date badge; description is blurred so
     users can see something is there but cannot read it yet. */
  /* Local-preview affordance on locked cards. Not rendered in production. */
  .preview-link {
    position: relative;
    z-index: 1;
    display: inline-block;
    margin-top: 0.6rem;
    padding: 0.3rem 0.6rem;
    border: 2px dashed var(--purple);
    border-radius: 8px;
    background: #ffffff;
    color: var(--purple) !important;
    font-size: 0.78rem;
    font-weight: 700;
    text-decoration: none !important;
    pointer-events: auto;
    cursor: pointer;
  }

  .ttm-card-locked {
    position: relative;
    background: rgba(244, 255, 232, 0.55);
    border-color: rgba(105, 0, 90, 0.18);
    cursor: not-allowed;
  }

  .ttm-card-locked .ttm-title {
    color: var(--purple);
    opacity: 0.72;
  }

  .ttm-description-blur {
    opacity: 0.7;
  }

  .ttm-lock-badge {
    display: inline-block;
    margin-bottom: 0.45rem;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    background: var(--purple);
    color: var(--green-light);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .content-feedback-cta {
    margin: 1.4rem 0 0;
    text-align: center;
  }

  .content-feedback-cta p {
    margin: 0 0 0.55rem;
    color: var(--green-light);
  }

  .feedback-cta-link {
    display: inline-block;
    border: 2px solid var(--green-lime);
    border-radius: 8px;
    padding: 0.5rem 0.9rem;
    background: var(--green-lime);
    color: var(--green-dark) !important;
    font-weight: 700;
    text-decoration: none !important;
  }

  .feedback-cta-link:hover {
    border-color: var(--purple-light);
    background: var(--purple-light);
  }







  /* Cards match the series tiles on the homepage: white, a coloured top
     edge for the series, lifting on hover. Locked entries stay flat so the
     page is not wall-to-wall boxes; only what you can read now is raised.
     The intro and the feedback line lose their panels for the same reason. */
  .ttm-card:not(.ttm-card-locked, .ttm-card-missing) {
    background: #ffffff;
    border: 2px solid rgba(105, 0, 90, 0.18);
    border-top: 6px solid var(--purple);
    border-radius: 14px;
    padding: 1.1rem 1.2rem 1.2rem;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.16);
  }


  .ttm-card:not(.ttm-card-locked, .ttm-card-missing) .ttm-title {
    color: var(--green-dark) !important;
  }

  /* Locked and coming-soon entries: no panel, just a divider. */
  .ttm-card.ttm-card-locked, .ttm-card-missing {
    background: none;
    border: none;
    border-bottom: 1px solid rgba(192, 254, 113, 0.16);
    border-radius: 0;
    box-shadow: none;
    padding: 0.85rem 0 1rem;
  }

  .saoirse-bubble {
    background: none;
    border: none;
    border-radius: 0;
    box-shadow: none;
    padding: 0;
  }

  .saoirse-bubble::before,
  .saoirse-bubble::after { display: none; }

  .content-feedback-cta {
    background: none;
    border: none;
    box-shadow: none;
    padding: 1.2rem 0 0;
    text-align: left;
  }

  /* Locked entries sit flat on the page background (#030a06), so their text
     has to be light. It was still the dark colour from when every card had
     a white panel behind it, which made it unreadable. */
  .ttm-card.ttm-card-locked .ttm-title,
  .ttm-card-missing .ttm-title,
  .ttm-card-planned .ttm-title {
    color: var(--green-light) !important;
    opacity: 0.9;
  }

  .ttm-card.ttm-card-locked .ttm-description,
  .ttm-card-missing .ttm-description,
  .ttm-card-planned .ttm-description {
    color: var(--green-light) !important;
    opacity: 0.75;
  }

</style>
