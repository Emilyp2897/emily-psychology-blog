---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { trainingTheMindSeries } from '../../data/series';

// Rendered on demand rather than at build time. The scheduled-release locks
// below compare pubDate against "now", so a prerendered page would freeze
// that comparison at build time and a post would stay locked until the next
// deploy instead of unlocking on its release date.
export const prerender = false;

const allPosts = await getCollection('blog');

// Scheduled-release helper. Posts with a pubDate in the future render as
// locked cards (blurred preview, release date shown, no link) until the
// release date passes. Computed at request time so the lock lifts
// automatically without a redeploy.
const today = new Date();
today.setHours(0, 0, 0, 0);

const isUnreleased = (date: Date) => date > today;

// Locked cards keep their locked appearance when running locally, but gain a
// preview link so unreleased drafts can be reviewed on the real page without
// typing URLs by hand. Never rendered in production.
const previewUnlocked = import.meta.env.DEV;

const releaseDateLabel = (date: Date) =>
  date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

const monthlySeries = trainingTheMindSeries;

function postFor(slug: string) {
  return allPosts.find((post) => post.slug === slug);
}

// Next post still to be released, for the schedule box. Picks the earliest
// unreleased pubDate rather than the first unreleased post in series order,
// because the two are not always the same (Month 1 has two posts sharing a
// date, and series order does not strictly follow date order).
// Ties are real: Month 1 has two posts sharing 2026-08-01, so fall back to
// the order they appear in on the page to keep the result deterministic.
const seriesOrder = new Map(
  monthlySeries.flatMap((entry) => entry.slugs).map((slug, index) => [slug, index] as const)
);

const nextRelease = allPosts
  .filter((post) => seriesOrder.has(post.slug) && isUnreleased(post.data.pubDate))
  .sort(
    (a, b) =>
      a.data.pubDate.valueOf() - b.data.pubDate.valueOf() ||
      (seriesOrder.get(a.slug) ?? 0) - (seriesOrder.get(b.slug) ?? 0)
  )[0];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Training the Mind | ${SITE_TITLE}`} description="A 12-month journey through the mental side of sport, built for female athletes." />
  </head>
  <body class="ttm-page">
    <Header />
    <main class="container ttm-main">
      <section class="hero">
        <p class="hero-kicker">Content Hub Series</p>
        <h1>Training the Mind</h1>
        <p class="hero-tagline">Sports psychology in language that makes sense on the pitch.</p>
      </section>

      <div class="intro-card">
        <p>Each month takes one theme from the mental side of sport and covers it twice: once to understand the theory, once to apply it in real Gaelic football situations. Every post has a companion toolkit in the Gael Performance Toolkit.</p>
      </div>

      <div class="release-schedule-banner" role="note">
        <p class="release-eyebrow">Release schedule</p>
        <p class="release-body"><strong>Free to read, no subscription.</strong> Two posts release each month. {nextRelease
          ? `The next one, ${nextRelease.data.title}, is out on ${releaseDateLabel(nextRelease.data.pubDate)}.`
          : 'Every post in the series is now available.'}</p>
      </div>

      <section class="ttm-series" aria-label="Monthly blog posts">
        {monthlySeries.map((entry) => (
          <div class="month-group">
            <h3 class="month-heading">{entry.month}: {entry.theme}</h3>
            <ul class="month-list">
              {entry.slugs.map((slug) => {
                const post = postFor(slug);
                if (!post) {
                  return (
                    <li class="ttm-card ttm-card-missing">
                      <span class="ttm-status">Coming soon</span>
                      <h4 class="ttm-title">{slug.split('/').pop()?.replace(/-/g, ' ')}</h4>
                    </li>
                  );
                }
                if (isUnreleased(post.data.pubDate)) {
                  return (
                    <li class="ttm-card ttm-card-locked" aria-disabled="true">
                      <span class="ttm-lock-badge">🔒 Releases {releaseDateLabel(post.data.pubDate)}</span>
                      <h4 class="ttm-title">{post.data.title}</h4>
                      {post.data.description && (
                        <p class="ttm-description ttm-description-blur">{post.data.description}</p>
                      )}
                      {previewUnlocked && (
                        <a class="preview-link" href={`/content-hub/${post.slug}/`}>Preview draft (local only) →</a>
                      )}
                    </li>
                  );
                }
                return (
                  <li class="ttm-card">
                    <a href={`/content-hub/${post.slug}/`}>
                      <h4 class="ttm-title">{post.data.title}</h4>
                      {post.data.description && (
                        <p class="ttm-description">{post.data.description}</p>
                      )}
                      <span class="ttm-cta">Read post →</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </section>

      <section class="content-feedback-cta" aria-label="Content feedback">
        <p>Got feedback on this content?</p>
        <a href="/content-feedback" class="feedback-cta-link">Share feedback</a>
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  .ttm-main {
    padding-top: 0;
    padding-bottom: 3rem;
  }

  .hero {
    margin: 0 calc(50% - 50vw) 0.8rem;
    padding: 2rem max(1rem, calc(50vw - 600px + 1rem));
    background: linear-gradient(180deg, rgba(3, 10, 6, 0.95) 0%, rgba(3, 10, 6, 0.82) 100%);
  }

  .hero-kicker {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.75rem;
    color: var(--purple-light);
    font-weight: 700;
  }

  .hero h1 {
    margin: 0.2rem 0 0;
    color: var(--green-lime);
  }

  .hero-tagline {
    margin: 0.35rem 0 0;
    color: var(--green-light);
    max-width: 64ch;
  }

  /* White intro box and lime release-schedule box, matching the pattern on
     the Strong Minds, Stronger Players page. */
  .intro-card {
    background: #ffffff;
    border: 2px solid rgba(105, 0, 90, 0.22);
    border-radius: 8px;
    padding: 1.5rem;
    margin-bottom: 1rem;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.12);
    color: #000000;
  }

  .intro-card p {
    color: #000000;
    margin: 0;
  }

  .release-schedule-banner {
    margin-bottom: 1rem;
    padding: 1.1rem 1.25rem;
    background: rgba(192, 254, 113, 0.12);
    border: 2px solid var(--green-lime);
    border-radius: 10px;
    text-align: center;
  }

  .release-eyebrow {
    margin: 0 0 0.3rem;
    color: var(--green-lime);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.78rem;
    font-weight: 800;
  }

  .release-body {
    margin: 0;
    color: var(--green-light);
    line-height: 1.5;
  }

  .ttm-series {
    margin-top: 0.4rem;
    margin-bottom: 1.6rem;
  }

  .month-group {
    margin-top: 1rem;
  }

  .month-heading {
    color: var(--purple-light);
    margin: 0 0 0.5rem;
    font-size: 1.15rem;
    font-weight: 700;
  }

  .month-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }

  /* White cards with dark titles. */
  .ttm-card {
    border: 2px solid rgba(105, 0, 90, 0.18);
    border-radius: 12px;
    padding: 1rem 1.1rem 1.1rem;
    background: #ffffff;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .ttm-card:hover {
    transform: translateY(-3px);
    border-color: var(--purple);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.18);
  }

  .ttm-card a {
    display: block;
    text-decoration: none !important;
    color: inherit !important;
  }

  .ttm-status {
    display: inline-block;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    background: var(--purple);
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 0.45rem;
  }

  .ttm-title {
    color: var(--green-dark) !important;
    font-size: 1.05rem;
    margin: 0 0 0.4rem;
    line-height: 1.35;
    font-weight: 700;
  }

  .ttm-description {
    color: var(--green-dark);
    font-size: 0.92rem;
    margin: 0 0 0.7rem;
    line-height: 1.5;
    opacity: 0.82;
  }

  .ttm-cta {
    color: var(--purple);
    font-weight: 700;
    font-size: 0.85rem;
  }

  .ttm-card-missing {
    opacity: 0.65;
    background: #f7f5f8;
  }

  /* Scheduled-release lock: post pubDate is in the future. Card is shown
     in muted form with a release-date badge; description is blurred so
     users can see something is there but cannot read it yet. */
  /* Local-preview affordance on locked cards. Not rendered in production. */
  .preview-link {
    position: relative;
    z-index: 1;
    display: inline-block;
    margin-top: 0.6rem;
    padding: 0.3rem 0.6rem;
    border: 2px dashed var(--purple);
    border-radius: 8px;
    background: #ffffff;
    color: var(--purple) !important;
    font-size: 0.78rem;
    font-weight: 700;
    text-decoration: none !important;
    pointer-events: auto;
    cursor: pointer;
  }

  .ttm-card-locked {
    position: relative;
    background: rgba(244, 255, 232, 0.55);
    border-color: rgba(105, 0, 90, 0.18);
    cursor: not-allowed;
  }

  .ttm-card-locked .ttm-title {
    color: var(--purple);
    opacity: 0.72;
  }

  .ttm-description-blur {
    filter: blur(4px);
    user-select: none;
    pointer-events: none;
    opacity: 0.7;
  }

  .ttm-lock-badge {
    display: inline-block;
    margin-bottom: 0.45rem;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    background: var(--purple);
    color: var(--green-light);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .content-feedback-cta {
    margin: 1.4rem 0 0;
    text-align: center;
  }

  .content-feedback-cta p {
    margin: 0 0 0.55rem;
    color: var(--green-light);
  }

  .feedback-cta-link {
    display: inline-block;
    border: 2px solid var(--green-lime);
    border-radius: 8px;
    padding: 0.5rem 0.9rem;
    background: var(--green-lime);
    color: var(--green-dark) !important;
    font-weight: 700;
    text-decoration: none !important;
  }

  .feedback-cta-link:hover {
    border-color: var(--purple-light);
    background: var(--purple-light);
  }
</style>
