---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { isLocked, isScheduled, lockLabel } from '../../data/release';

// Rendered on demand rather than at build time, so the release locks below
// lift on their release date instead of waiting for the next deploy.
export const prerender = false;

const allPosts = await getCollection('blog');

// Matching Training the Mind and the Gael Performance Toolkit: a post renders
// as a locked card (blurred preview, no link) when its pubDate is still in
// the future OR when it carries an editorial hold. See data/release.ts.
// SMSP is always free, so this is a release schedule, not a paywall.

// Locked cards keep their locked appearance when running locally, but gain a
// preview link so unreleased drafts can be reviewed on the real page without
// typing URLs by hand. Never rendered in production.
const previewUnlocked = import.meta.env.DEV;

const childPosts = allPosts
  .filter(
    (post) => post.slug.startsWith('strong-minds-stronger-players/') && post.slug !== 'strong-minds-stronger-players/strong-minds-stronger-players'
  )
  .sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());

const nextRelease = childPosts.find((post) => isScheduled(post));
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead title={`Strong Minds, Stronger Players | ${SITE_TITLE}`} description="Understand mental health, recognising what to look out for, when pressure becomes something more serious, and how to seek the right support when you need it." />
  </head>
  <body class="strong-minds-page">
    <Header />
    <main class="container strong-minds-main">
      <section class="hero">
        <p class="hero-kicker">Content Hub Series</p>
        <h1>Strong Minds, Stronger Players</h1>
        <p class="hero-tagline">Understanding mental health in sport, spotting warning signs early, and knowing where to seek support.</p>
      </section>

      <div class="series-lead">
        <img src="/assets/saoirse.png" alt="" class="saoirse-avatar" aria-hidden="true" />
        <div class="saoirse-bubble">
        <p class="series-lead-copy">Recognising changes early, understanding what they might mean, and knowing when it is time to talk to someone. For yourself or for a teammate.</p>
        </div>
      </div>

      <section class="latest-blog-box">
        <ul id="posts-list" class="latest-posts">
          {childPosts.length > 0 ? childPosts.map((post) => (
            isLocked(post) ? (
              <li class="smsp-card smsp-card-locked" aria-disabled="true">
                <span class="smsp-lock-badge">🔒 {lockLabel(post)}</span>
                <h2 class="title">{post.data.title}</h2>
                {post.data.description && (
                  <p class="description smsp-description-blur">{post.data.description}</p>
                )}
                {previewUnlocked && (
                  <a class="preview-link" href={`/content-hub/${post.slug}/`}>Preview draft (local only) →</a>
                )}
              </li>
            ) : (
              <li class="smsp-card">
                <a href={`/content-hub/${post.slug}/`}>
                  <h2 class="title">{post.data.title}</h2>
                  {post.data.description && (
                    <p class="description">{post.data.description}</p>
                  )}
                  <span class="smsp-cta">Read post →</span>
                </a>
              </li>
            )
          )) : (
            <li class="coming-soon">
              <p>Posts coming soon. Check back shortly.</p>
            </li>
          )}
        </ul>
      </section>

      <section class="content-feedback-cta">
        <p>Got feedback on this content?</p>
        <a href="/content-feedback" class="feedback-cta-link">Share Feedback</a>
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  /* Saoirse introduces each series. Replaces a white card stacked on a
     bordered banner, which read as two grey boxes before you reached any
     content. She "says" the intro, with the schedule as pills underneath. */
  .series-lead {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    margin: 0 0 1.75rem;
  }

  .saoirse-avatar {
    flex: 0 0 auto;
    width: 78px;
    height: 78px;
    object-fit: contain;
    margin-top: 0.4rem;
    animation: saoirse-bob 3.2s ease-in-out infinite;
  }

  @keyframes saoirse-bob {
    0%, 100% { transform: translateY(0) rotate(-3deg); }
    50%      { transform: translateY(-6px) rotate(3deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .saoirse-avatar { animation: none; }
  }

  .saoirse-bubble {
    position: relative;
    flex: 1 1 auto;
    padding: 1.1rem 1.25rem;
    background: #ffffff;
    border: 3px solid var(--purple);
    border-radius: 18px;
    box-shadow: 0 8px 0 rgba(105, 0, 90, 0.18);
  }

  /* Tail pointing back at Saoirse. Two triangles so it gets a border too. */
  .saoirse-bubble::before,
  .saoirse-bubble::after {
    content: "";
    position: absolute;
    top: 24px;
    width: 0;
    height: 0;
    border-style: solid;
  }

  .saoirse-bubble::before {
    left: -16px;
    border-width: 10px 16px 10px 0;
    border-color: transparent var(--purple) transparent transparent;
  }

  .saoirse-bubble::after {
    left: -11px;
    border-width: 7px 12px 7px 0;
    border-color: transparent #ffffff transparent transparent;
  }

  .series-lead-copy {
    margin: 0 0 0.8rem;
    color: var(--green-dark);
    font-size: 1.05rem;
    line-height: 1.55;
  }

  .series-lead-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0;
  }

  .lead-pill {
    display: inline-block;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    border: 2px solid var(--purple);
    color: var(--purple);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .lead-pill-free {
    background: var(--green-lime);
    border-color: var(--green-lime);
    color: var(--green-dark);
    font-weight: 800;
  }

  @media (max-width: 720px) {
    .saoirse-avatar { width: 54px; height: 54px; }
    .saoirse-bubble { padding: 0.9rem 1rem; }
    .series-lead-copy { font-size: 0.98rem; }
  }

  .strong-minds-main {
    padding-top: 0;
    padding-bottom: 3rem;
  }

  .hero {
    margin: 0 calc(50% - 50vw) 1.1rem;
    padding: 2rem max(1rem, calc(50vw - 600px + 1rem));
    background: linear-gradient(180deg, rgba(3, 10, 6, 0.95) 0%, rgba(3, 10, 6, 0.82) 100%);
  }

  .hero-kicker {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.75rem;
    color: var(--purple-light);
    font-weight: 700;
  }

  .hero h1 {
    margin: 0.2rem 0 0;
    color: var(--green-lime);
  }

  .hero-tagline {
    margin: 0.35rem 0 0;
    color: var(--green-light);
    max-width: 64ch;
  }

  .intro-card,
  .latest-blog-box,
  .content-feedback-cta {
    background: #ffffff;
    border: 2px solid rgba(105, 0, 90, 0.22);
    border-radius: 8px;
    padding: 1.5rem;
    margin-bottom: 1rem;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.12);
    color: #000000;
  }

  .smsp-coming-soon-banner {
    margin-bottom: 1rem;
    padding: 1.1rem 1.25rem;
    background: rgba(192, 254, 113, 0.12);
    border: 2px solid var(--green-lime);
    border-radius: 10px;
    text-align: center;
  }

  .smsp-cs-eyebrow {
    margin: 0 0 0.3rem;
    color: var(--green-lime);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.78rem;
    font-weight: 800;
  }

  .smsp-cs-body {
    margin: 0;
    color: var(--green-light);
    line-height: 1.5;
  }

  .intro-card p,
  .content-feedback-cta p {
    color: #000000;
    margin: 0;
  }

  .latest-posts {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .latest-posts li {
    margin-bottom: 0.9rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid rgba(192, 254, 113, 0.2);
  }

  .latest-posts li:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .latest-posts li a {
    display: block;
    text-decoration: none;
    color: #000000 !important;
  }

  .latest-posts li a:hover .title {
    color: var(--purple);
  }

  .latest-posts .title {
    margin: 0 0 0.25rem;
    font-size: 1.15rem;
    color: #000000;
  }

  .latest-posts .description {
    margin: 0;
    color: #000000;
    line-height: 1.5;
    font-size: 0.96rem;
  }

  .coming-soon {
    border-bottom: none !important;
    padding-bottom: 0 !important;
    margin-bottom: 0 !important;
  }

  .smsp-cta {
    display: inline-block;
    margin-top: 0.35rem;
    color: var(--purple);
    font-weight: 700;
    font-size: 0.85rem;
  }

  /* Scheduled-release lock cards (mirror the TTM lock-card pattern). A post
     whose pubDate is still in the future renders as a non-clickable card
     with its release date, a blurred description teaser, and no link. The
     lock lifts by itself on the release date. */
  /* Local-preview affordance on locked cards. Not rendered in production. */
  .preview-link {
    position: relative;
    z-index: 1;
    display: inline-block;
    margin-top: 0.6rem;
    padding: 0.3rem 0.6rem;
    border: 2px dashed var(--purple);
    border-radius: 8px;
    background: #ffffff;
    color: var(--purple) !important;
    font-size: 0.78rem;
    font-weight: 700;
    text-decoration: none !important;
    pointer-events: auto;
    cursor: pointer;
  }

  .smsp-card-locked {
    position: relative;
    padding: 1.1rem 1.25rem;
    background: rgba(192, 254, 113, 0.08);
    border: 2px dashed rgba(192, 254, 113, 0.55);
    border-radius: 10px;
    margin-bottom: 0.9rem;
    cursor: not-allowed;
    color: #1a1a1a;
  }

  .smsp-card-locked:last-child {
    margin-bottom: 0;
  }

  /* Purple, not lime. This badge sits on the white .latest-blog-box, and a
     lime pill on white is 1.19:1, so the badge shape vanished and only its
     text showed. */
  .smsp-lock-badge {
    display: inline-block;
    margin-bottom: 0.5rem;
    padding: 0.2rem 0.6rem;
    background: var(--purple);
    color: #ffffff;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .smsp-card-locked .title {
    margin: 0 0 0.3rem;
    color: #1a1a1a;
    font-size: 1.1rem;
    opacity: 0.85;
  }

  .smsp-description-blur {
    margin: 0;
    /* Light, because locked cards are now flat on the dark page. */
    color: var(--green-light);
    line-height: 1.5;
    font-size: 0.94rem;
  }

  .content-feedback-cta {
    text-align: center;
  }

  .feedback-cta-link {
    display: inline-block;
    margin-top: 0.6rem;
    border: 2px solid var(--green-lime);
    border-radius: 8px;
    padding: 0.48rem 0.85rem;
    background: var(--green-lime);
    color: var(--green-dark) !important;
    font-weight: 700;
    text-decoration: none !important;
  }

  .feedback-cta-link:hover {
    border-color: var(--purple-light);
    color: var(--purple) !important;
  }

  @media (max-width: 720px) {
    .strong-minds-main {
      padding-bottom: 2rem;
    }

    .hero {
      padding: 1.4rem max(0.85rem, calc(50vw - 600px + 1rem));
      margin-bottom: 0.9rem;
    }

    .intro-card,
    .latest-blog-box,
    .content-feedback-cta {
      padding: 1rem;
    }
  }







  /* Cards match the series tiles on the homepage: white, a coloured top
     edge for the series, lifting on hover. Locked entries stay flat so the
     page is not wall-to-wall boxes; only what you can read now is raised.
     The intro and the feedback line lose their panels for the same reason. */
  .smsp-card:not(.smsp-card-locked) {
    background: #ffffff;
    border: 2px solid rgba(105, 0, 90, 0.18);
    border-top: 6px solid #1d6fb8;
    border-radius: 14px;
    padding: 1.1rem 1.2rem 1.2rem;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.16);
  }


  .smsp-card:not(.smsp-card-locked) .title {
    color: var(--green-dark) !important;
  }

  /* Locked and coming-soon entries: no panel, just a divider. */
  .smsp-card.smsp-card-locked {
    background: none;
    border: none;
    /* Divider against the white panel, so purple. The lime one was invisible
       for the same reason the badge was. */
    border-bottom: 1px solid rgba(105, 0, 90, 0.2);
    border-radius: 0;
    box-shadow: none;
    padding: 0.85rem 0 1rem;
  }

  .saoirse-bubble {
    background: none;
    border: none;
    border-radius: 0;
    box-shadow: none;
    padding: 0;
  }

  .saoirse-bubble::before,
  .saoirse-bubble::after { display: none; }

  .content-feedback-cta {
    background: none;
    border: none;
    box-shadow: none;
    padding: 1.2rem 0 0;
    text-align: left;
  }

  /* These were light green, on the assumption that a locked entry sits flat
     on the dark page background. It does not: the whole list is inside
     .latest-blog-box, which is white. Light green on white is 1.05:1, so the
     coming-soon entries were effectively invisible. Dark text on the white
     panel instead, at 17.4:1. */
  .smsp-card.smsp-card-locked .title,
  .smsp-card-missing .title,
  .smsp-card-planned .title {
    color: #1a1a1a !important;
    opacity: 1;
  }

  .smsp-card.smsp-card-locked .description,
  .smsp-card-missing .description,
  .smsp-card-planned .description {
    color: #333333 !important;
    opacity: 1;
  }

</style>
