---
import { getCollection } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

// Rendered on demand rather than prerendered. The SMSP release gate in
// BlogPost.astro compares pubDate against "now", and the hub pages are also
// on-demand, so a prerendered article would still show "not out yet" after
// its hub card had already unlocked.
export const prerender = false;

const reservedSectionSlugs = new Set([
  'training-the-mind',
  'gael-performance-toolkit',
  'strong-minds-stronger-players',
]);

const slug = Astro.params.slug ?? '';

const posts = await getCollection('blog', (entry) => !entry.data.draft);
const post = reservedSectionSlugs.has(slug)
  ? undefined
  : posts.find((entry) => entry.slug === slug);

if (!post) {
  return new Response(null, { status: 404, statusText: 'Not found' });
}

const { Content } = await post.render();
---

<BlogPost {...post.data} postSlug={post.slug}>
  <Content />
</BlogPost>
