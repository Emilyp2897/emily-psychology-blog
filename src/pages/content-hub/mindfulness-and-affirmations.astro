---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

// Rendered on demand rather than at build time, so the release locks below
// lift on their release date instead of waiting for the next deploy.
export const prerender = false;

const allPosts = await getCollection('blog');

// Normalised in UTC, not local time. Frontmatter dates like "2026-09-16" parse
// as UTC midnight, so normalising to LOCAL midnight puts "today" an hour behind
// during BST and a post dated today stays locked until 01:00.
const today = new Date();
today.setUTCHours(0, 0, 0, 0);

const isUnreleased = (date: Date) => date > today;
const previewUnlocked = import.meta.env.DEV;

const releaseDateLabel = (date: Date) =>
  date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

const posts = allPosts
  .filter((post) => post.slug.startsWith('mindfulness-and-affirmations/'))
  .sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());

// Planned pieces that have no draft yet. Shown as coming-soon cards so the
// shape of the series is visible without pretending the content exists.
const plannedTopics = [
  'A pre-match body scan you can do on the bus',
  'Affirmations for coming back from injury',
  'Mindfulness for the week after a bad loss',
  'Off-season reset: sitting still without the guilt',
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead
      title={`Mindfulness & Affirmations | ${SITE_TITLE}`}
      description="Short mindfulness practices and affirmations built for female athletes. For championship week, and for life outside the sport."
    />
  </head>
  <body class="mindfulness-page">
    <Header />
    <main class="container mindfulness-main">
      <section class="hero">
        <p class="hero-kicker">Content Hub Series</p>
        <h1>Mindfulness &amp; Affirmations</h1>
        <p class="hero-tagline">Short practices you will actually do, and affirmations that do not make you cringe.</p>
      </section>

      <div class="series-lead">
        <img src="/assets/saoirse.png" alt="" class="saoirse-avatar" aria-hidden="true" />
        <div class="saoirse-bubble">
        <p class="series-lead-copy">Nothing here takes longer than five minutes. Short practices and affirmations, built on the research into attention and self-affirmation. Some are for match week, some are for the rest of your life.</p>
        <p class="series-lead-meta">
          <span class="lead-pill lead-pill-free">Free, no sign-up</span>
          <span class="lead-pill">Read as slides you can swipe</span>
          <span class="lead-pill">Championship pieces live now</span>
        </p>
        </div>
      </div>

      <section class="mindfulness-series" aria-label="Mindfulness and affirmations">
        <ul class="mindfulness-list">
          {posts.map((post) => (
            isUnreleased(post.data.pubDate) ? (
              <li class="mindfulness-card mindfulness-card-locked" aria-disabled="true">
                <span class="lock-badge">🔒 Releases {releaseDateLabel(post.data.pubDate)}</span>
                <h2 class="card-title">{post.data.title}</h2>
                {post.data.description && (
                  <p class="card-description description-blur">{post.data.description}</p>
                )}
                {previewUnlocked && (
                  <a class="preview-link" href={`/content-hub/${post.slug}/`}>Preview draft (local only) →</a>
                )}
              </li>
            ) : (
              <li class="mindfulness-card">
                <a href={`/content-hub/${post.slug}/`}>
                  {post.data.tags?.includes('championship') && (
                    <span class="champo-badge">Champo week</span>
                  )}
                  <h2 class="card-title">{post.data.title}</h2>
                  {post.data.description && (
                    <p class="card-description">{post.data.description}</p>
                  )}
                  <span class="card-cta">Read it →</span>
                </a>
              </li>
            )
          ))}

          {plannedTopics.map((topic) => (
            <li class="mindfulness-card mindfulness-card-planned" aria-disabled="true">
              <span class="soon-badge">Coming soon</span>
              <h2 class="card-title">{topic}</h2>
            </li>
          ))}
        </ul>
      </section>

      <section class="content-feedback-cta">
        <p>Got feedback on this content?</p>
        <a href="/content-feedback" class="feedback-cta-link">Share Feedback</a>
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  /* Saoirse introduces each series. Replaces a white card stacked on a
     bordered banner, which read as two grey boxes before you reached any
     content. She "says" the intro, with the schedule as pills underneath. */
  .series-lead {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    margin: 0 0 1.75rem;
  }

  .saoirse-avatar {
    flex: 0 0 auto;
    width: 78px;
    height: 78px;
    object-fit: contain;
    margin-top: 0.4rem;
    animation: saoirse-bob 3.2s ease-in-out infinite;
  }

  @keyframes saoirse-bob {
    0%, 100% { transform: translateY(0) rotate(-3deg); }
    50%      { transform: translateY(-6px) rotate(3deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .saoirse-avatar { animation: none; }
  }

  .saoirse-bubble {
    position: relative;
    flex: 1 1 auto;
    padding: 1.1rem 1.25rem;
    background: #ffffff;
    border: 3px solid var(--purple);
    border-radius: 18px;
    box-shadow: 0 8px 0 rgba(105, 0, 90, 0.18);
  }

  /* Tail pointing back at Saoirse. Two triangles so it gets a border too. */
  .saoirse-bubble::before,
  .saoirse-bubble::after {
    content: "";
    position: absolute;
    top: 24px;
    width: 0;
    height: 0;
    border-style: solid;
  }

  .saoirse-bubble::before {
    left: -16px;
    border-width: 10px 16px 10px 0;
    border-color: transparent var(--purple) transparent transparent;
  }

  .saoirse-bubble::after {
    left: -11px;
    border-width: 7px 12px 7px 0;
    border-color: transparent #ffffff transparent transparent;
  }

  .series-lead-copy {
    margin: 0 0 0.8rem;
    color: var(--green-dark);
    font-size: 1.05rem;
    line-height: 1.55;
  }

  .series-lead-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0;
  }

  .lead-pill {
    display: inline-block;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    border: 2px solid var(--purple);
    color: var(--purple);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .lead-pill-free {
    background: var(--green-lime);
    border-color: var(--green-lime);
    color: var(--green-dark);
    font-weight: 800;
  }

  @media (max-width: 720px) {
    .saoirse-avatar { width: 54px; height: 54px; }
    .saoirse-bubble { padding: 0.9rem 1rem; }
    .series-lead-copy { font-size: 0.98rem; }
  }

  .mindfulness-main {
    padding-top: 0;
    padding-bottom: 3rem;
  }

  .hero {
    margin: 0 calc(50% - 50vw) 1.1rem;
    padding: 2rem max(1rem, calc(50vw - 600px + 1rem));
    background: linear-gradient(180deg, rgba(3, 10, 6, 0.95) 0%, rgba(3, 10, 6, 0.82) 100%);
  }

  .hero-kicker {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.75rem;
    color: var(--purple-light);
    font-weight: 700;
  }

  .hero h1 {
    margin: 0.2rem 0 0;
    color: var(--green-lime);
  }

  .hero-tagline {
    margin: 0.35rem 0 0;
    color: var(--green-light);
    max-width: 64ch;
  }

  .intro-card {
    background: #ffffff;
    border: 2px solid rgba(105, 0, 90, 0.22);
    border-radius: 8px;
    padding: 1.5rem;
    margin-bottom: 1rem;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.12);
    color: #000000;
  }

  .intro-card p {
    color: #000000;
    margin: 0;
  }

  .release-schedule-banner {
    margin-bottom: 1rem;
    padding: 1.1rem 1.25rem;
    background: rgba(192, 254, 113, 0.12);
    border: 2px solid var(--green-lime);
    border-radius: 10px;
    text-align: center;
  }

  .release-eyebrow {
    margin: 0 0 0.3rem;
    color: var(--green-lime);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.78rem;
    font-weight: 800;
  }

  .release-body {
    margin: 0;
    color: var(--green-light);
    line-height: 1.5;
  }

  .mindfulness-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }

  .mindfulness-card {
    border: 2px solid rgba(105, 0, 90, 0.18);
    border-radius: 12px;
    padding: 1rem 1.1rem 1.1rem;
    background: #ffffff;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .mindfulness-card:hover {
    transform: translateY(-3px);
    border-color: var(--purple);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.18);
  }

  .mindfulness-card a {
    display: block;
    text-decoration: none !important;
    color: inherit !important;
  }

  .card-title {
    color: var(--green-dark) !important;
    font-size: 1.05rem;
    margin: 0 0 0.4rem;
    line-height: 1.35;
    font-weight: 700;
  }

  .card-description {
    color: var(--green-dark);
    font-size: 0.92rem;
    margin: 0 0 0.7rem;
    line-height: 1.5;
    opacity: 0.82;
  }

  .card-cta {
    color: var(--purple);
    font-weight: 700;
    font-size: 0.85rem;
  }

  .champo-badge,
  .soon-badge,
  .lock-badge {
    display: inline-block;
    margin-bottom: 0.5rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .champo-badge {
    background: var(--green-lime);
    color: var(--green-dark);
  }

  .soon-badge,
  .lock-badge {
    background: var(--purple);
    color: #ffffff;
  }

  .mindfulness-card-planned,
  .mindfulness-card-locked {
    background: rgba(244, 255, 232, 0.55);
    border-style: dashed;
    cursor: not-allowed;
  }

  .mindfulness-card-planned:hover,
  .mindfulness-card-locked:hover {
    transform: none;
    border-color: rgba(105, 0, 90, 0.18);
    box-shadow: none;
  }

  .description-blur {
    filter: blur(2.5px);
    user-select: none;
    pointer-events: none;
  }

  /* Local-preview affordance on locked cards. Not rendered in production. */
  .preview-link {
    position: relative;
    z-index: 1;
    display: inline-block;
    margin-top: 0.6rem;
    padding: 0.3rem 0.6rem;
    border: 2px dashed var(--purple);
    border-radius: 8px;
    background: #ffffff;
    color: var(--purple) !important;
    font-size: 0.78rem;
    font-weight: 700;
    text-decoration: none !important;
    cursor: pointer;
  }

  .content-feedback-cta {
    background: #ffffff;
    border: 2px solid rgba(105, 0, 90, 0.22);
    border-radius: 8px;
    padding: 1.5rem;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.12);
    color: #000000;
    text-align: center;
  }

  .content-feedback-cta p {
    color: #000000;
    margin: 0;
  }

  .feedback-cta-link {
    display: inline-block;
    margin-top: 0.6rem;
    border: 2px solid var(--green-lime);
    border-radius: 8px;
    padding: 0.48rem 0.85rem;
    background: var(--green-lime);
    color: var(--green-dark) !important;
    font-weight: 700;
    text-decoration: none !important;
  }

  .feedback-cta-link:hover {
    border-color: var(--purple-light);
    color: var(--purple) !important;
  }

  @media (max-width: 720px) {
    .hero {
      padding: 1.4rem max(0.85rem, calc(50vw - 600px + 1rem));
      margin-bottom: 0.9rem;
    }

    .intro-card,
    .content-feedback-cta {
      padding: 1rem;
    }
  }
</style>
