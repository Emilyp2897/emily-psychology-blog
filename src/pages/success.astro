---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import mtgLogo from '../assets/MTG_colour.png';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Subscription Confirmed | ${SITE_TITLE}`} description="Your subscription is active. Welcome to Mind the Gael." />
  </head>
  <body>
    <Header />
    <main class="container">
      <section class="status-band">
        <div class="status-band-inner">
          <Image src={mtgLogo} alt="" class="status-logo" loading="eager" aria-hidden="true" />
          <p class="status-eyebrow">Payment received</p>
          <h1>You are all set</h1>
          <p class="status-message">Thanks for subscribing. Your checkout completed successfully.</p>
          <p class="status-message">Use the button below to head back to the Content Hub and continue reading.</p>
          <div class="status-actions">
            <a href="/content-hub" class="status-action-primary">Go to Content Hub</a>
            <a href="/contact-us" class="status-action-secondary">Need help?</a>
          </div>
        </div>
      </section>
    </main>
    <Footer />

    <script is:inline>
      localStorage.setItem('mtg_subscribed', 'true');
    </script>
  </body>
</html>

