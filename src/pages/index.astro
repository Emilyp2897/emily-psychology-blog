---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PhotoCredit from '../components/PhotoCredit.astro';
import whyImage from '../assets/DSC_1538.jpg';
import mentalImage from '../assets/FLO_1671.jpg';
import hubImage from '../assets/HollowayTeamHuddle.jpg';
import physicalImage from '../assets/CiaraFlan-London-1.jpg';
import mtgLogo from '../assets/MTG_colour.png';
import footballImage from '../assets/football-illustration.jpg';
import { SITE_DESCRIPTION, SITE_TITLE_FULL } from '../consts';
import { isReleased, isScheduled } from '../data/release';
import { CHAMPO_TAG, gaelPerformanceToolkitSlugs, seriesHubHref, seriesLabels, trainingTheMindSlugs } from '../data/series';

// Rendered on demand rather than at build time, like the content hub pages.
// The "latest" and "next release" boxes below compare pubDate against "now",
// so a prerendered homepage would freeze them until the next deploy.
export const prerender = false;

const allPosts = await getCollection('blog');

// Mirrors the monthly toolkit order used on the Gael Performance Toolkit
// page itself, so "latest toolkit" here means the most recent released
// month in that sequence, not just whichever post has the newest date
// (which would wrongly pick up bonus/future toolkits outside the series).
const today = new Date();
today.setUTCHours(0, 0, 0, 0);

const orderedMonthlyToolkits = gaelPerformanceToolkitSlugs
  .map((slug) => allPosts.find((post) => post.slug === slug))
  .filter((post): post is (typeof allPosts)[number] => post !== undefined);

const releasedToolkits = orderedMonthlyToolkits.filter((post) => isReleased(post, today));
const latestToolkit = releasedToolkits[releasedToolkits.length - 1];
const nextToolkit = orderedMonthlyToolkits.find((post) => isScheduled(post, today));

// Latest released Training the Mind post, for the small box in that band.
// Uses the same series list as the hub page, so unlisted standalone theory
// posts under the same folder cannot be picked up as "latest".
const orderedTtmPosts = trainingTheMindSlugs
  .map((slug) => allPosts.find((post) => post.slug === slug))
  .filter((post): post is (typeof allPosts)[number] => post !== undefined);

const releasedTtmPosts = orderedTtmPosts.filter((post) => isReleased(post, today));
const latestTtmPost = releasedTtmPosts[releasedTtmPosts.length - 1];
const nextTtmPost = orderedTtmPosts.find((post) => isScheduled(post, today));

// Latest released Strong Minds, Stronger Players post. This series has no
// curated slug list, so it is derived from the collection by date, matching
// how the SMSP hub page orders it. The series index page is excluded.
const orderedSmspPosts = allPosts
  .filter(
    (post) =>
      post.slug.startsWith('strong-minds-stronger-players/') &&
      post.slug !== 'strong-minds-stronger-players/strong-minds-stronger-players'
  )
  .sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());

const releasedSmspPosts = orderedSmspPosts.filter((post) => isReleased(post, today));
const latestSmspPost = releasedSmspPosts[releasedSmspPosts.length - 1];
const nextSmspPost = orderedSmspPosts.find((post) => isScheduled(post, today));

const dateLabel = (date: Date) =>
  date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

// Each series band shows one post: the most recent released one, or the first
// upcoming one if the series has not started yet. Either way the box links
// straight to that article, so it is not a duplicate of the "read the series"
// link sitting underneath it.
type SeriesPost = (typeof allPosts)[number];

function featuredPostFor(latest: SeriesPost | undefined, next: SeriesPost | undefined) {
  if (latest) {
    return { post: latest, label: 'Latest', meta: dateLabel(latest.data.pubDate), upcoming: false };
  }
  if (next) {
    return { post: next, label: 'Up next', meta: `Out on ${dateLabel(next.data.pubDate)}`, upcoming: true };
  }
  return undefined;
}

const ttmFeatured = featuredPostFor(latestTtmPost, nextTtmPost);
const smspFeatured = featuredPostFor(latestSmspPost, nextSmspPost);
const toolkitFeatured = featuredPostFor(latestToolkit, nextToolkit);

const orderedMindfulnessPosts = allPosts
  .filter((post) => post.slug.startsWith('mindfulness-and-affirmations/'))
  .sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());

const releasedMindfulness = orderedMindfulnessPosts.filter((post) => isReleased(post, today));
const mindfulnessFeatured = featuredPostFor(
  releasedMindfulness[releasedMindfulness.length - 1],
  orderedMindfulnessPosts.find((post) => isScheduled(post, today))
);

// One card per series, replacing the three full-width bands that used to
// explain them one at a time. Keeps the explanation a first-time visitor
// needs without three screens of scrolling, and means a new series only has
// to be added here.
const homeSeries = [
  {
    key: 'training-the-mind',
    title: 'Training the Mind',
    blurb: 'Sports psychology in language that makes sense on the pitch. Twelve topics, each a 10 minute read, from pressure and performance anxiety to confidence and team culture.',
    href: '/content-hub/training-the-mind/',
    featured: ttmFeatured,
  },
  {
    key: 'gael-performance-toolkit',
    title: 'Gael Performance Toolkit',
    blurb: 'The practical half. Tools you can use before a game, between plays, and after the moments that knock your confidence. Each one pairs with a Training the Mind topic.',
    href: '/content-hub/gael-performance-toolkit/',
    featured: toolkitFeatured,
  },
  {
    key: 'strong-minds-stronger-players',
    title: 'Stronger Minds, Stronger Players',
    blurb: 'Mental health in sport. How to spot when pressure has turned into something more serious, in yourself or a teammate, and where to go for real support.',
    href: '/content-hub/strong-minds-stronger-players/',
    featured: smspFeatured,
  },
  {
    key: 'mindfulness-and-affirmations',
    title: 'Mindfulness & Affirmations',
    blurb: 'Five minute practices and affirmations that do not make you cringe. Built to read as slides you can swipe through. For match week, and for life outside it.',
    href: '/content-hub/mindfulness-and-affirmations/',
    featured: mindfulnessFeatured,
  },
];

// Champo Week: every released post tagged "championship", pulled from all four
// series. This is the headline theme while the championship is running, so it
// sits directly under the hero. Tag a post and it appears here automatically.
const champoPosts = allPosts
  .filter(
    (post) =>
      post.data.tags?.includes(CHAMPO_TAG) &&
      isReleased(post, today)
  )
  .sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE_FULL} description={SITE_DESCRIPTION} />
  </head>
  <body class="home-page home-page-hero-first">
    <main class="home-layout">

      <!-- HERO (animated) -->
      <section class="home-band home-hero">
        <div class="hero-stage-wrap">
          <div class="hero-stage">
            <Image src={footballImage} alt="" class="hero-fb" loading="eager" widths={[220, 320, 440]} sizes="220px" />
            <Image src={mtgLogo} alt="Mind the Gael" class="hero-logo" loading="eager" widths={[400, 600, 800]} sizes="(max-width: 600px) 280px, 480px" />
          </div>

          <h1 class="hero-tagline">Mental Performance for Female Athletes</h1>
          <p class="hero-sub">Four series on the mental side of sport: Training the Mind, the Gael Performance Toolkit, Stronger Minds, Stronger Players, and Mindfulness &amp; Affirmations. Women's health at the centre. Train your mind like you train your body.</p>

          <p class="hero-free-note">Every article and toolkit is <strong>free to read</strong>. Your own mental performance plan is the one thing you pay for, from £2.</p>
        </div>
      </section>

      <Header />

      <!-- CHAMPO WEEK: the headline theme while the championship is running.
           Sits directly under the hero so it is the first thing after the
           logo. Driven by the "championship" tag, so it can be retired by
           untagging rather than by editing this page. -->
      {champoPosts.length > 0 && (
        <section class="home-band champo-band" aria-labelledby="champo-heading">
          <div class="band-inner">
            <div class="champo-head">
              <p class="champo-eyebrow">Champo week</p>
              <h2 id="champo-heading">It's championship season. Here's everything to help you mentally prepare</h2>
              <p class="champo-sub">Pulled from every series: the psychology, the practical tools, the mental health side, and the short practices. All free.</p>
            </div>

            <ul class="champo-grid">
              {champoPosts.map((post) => (
                <li class="champo-tile">
                  <a href={`/content-hub/${post.slug}/`}>
                    <span class:list={["champo-series", `champo-series-${post.slug.split("/")[0]}`]}>{seriesLabels[post.slug.split('/')[0]] ?? 'Mind the Gael'}</span>
                    <h3 class="champo-title">{post.data.title}</h3>
                    {post.data.description && (
                      <p class="champo-desc">{post.data.description}</p>
                    )}
                    <span class="champo-cta">Open →</span>
                  </a>
                </li>
              ))}
            </ul>

            <div class="champo-links">
              {Object.entries(seriesHubHref).map(([key, href]) => (
                <a href={href} class:list={["champo-series-link", `champo-series-link-${key}`]}>{seriesLabels[key]}</a>
              ))}
            </div>
          </div>
        </section>
      )}

      <!-- 1. WHY (image + text) -->
      <section class="home-band band-light band-split" aria-labelledby="why-heading">
        <div class="band-inner band-split-inner">
          <div class="band-image">
            <Image src={whyImage} alt="Female athlete in training" class="band-photo" loading="lazy" widths={[600, 900, 1200]} sizes="(max-width: 900px) 100vw, 50vw" />
            <PhotoCredit src={whyImage.src} />
          </div>
          <div class="band-text">
            <p class="band-kicker">Why Mind the Gael exists</p>
            <h2 id="why-heading">Female athletes deserve consistent access to sports psychology.</h2>
            <p>Most do not get it. That creates a gap. A gap in understanding confidence, pressure, focus, anxiety, and mental wellbeing in sport, right when athletes need that understanding the most.</p>
            <p>Mind the Gael exists to help bridge that gap. The platform is built from my own experience as an athlete: struggling with anxiety, overthinking, confidence dips, and pressure, then realising I needed practical understanding, not generic motivation.</p>
            <p class="band-fine">This platform is not clinical advice or therapy. The aim is education and awareness, translating research into language that makes sense in real sport.</p>
          </div>
        </div>
      </section>

      <!-- 2. THE SERIES: one card each, replacing the three full-width bands
           that explained them one at a time. Mindfulness was missing entirely
           from the old layout. -->
      <section class="home-band band-light series-band" aria-labelledby="series-heading">
        <div class="band-inner">
          <div class="series-band-photo">
            <Image src={hubImage} alt="Team huddle at Holloway" class="series-band-img" loading="lazy" widths={[600, 900, 1400]} sizes="(max-width: 900px) 100vw, 1100px" />
            <PhotoCredit src={hubImage.src} />
          </div>

          <div class="series-band-head">
            <p class="band-kicker">The Content Hub <span class="band-tag band-tag-free">All free</span></p>
            <h2 id="series-heading">Four series on the mental side of sport.</h2>
            <p class="series-band-sub">No subscription and no sign-up. New pieces release on a schedule through the year.</p>
          </div>

          <ul class="series-grid">
            {homeSeries.map((s) => (
              <li class:list={["series-tile", `series-tile-${s.key}`]}>
                <a href={s.href}>
                  <h3 class="series-tile-title">{s.title}</h3>
                  <p class="series-tile-blurb">{s.blurb}</p>
                  {s.featured && (
                    <span class="series-tile-latest">
                      <span class="series-tile-label">{s.featured.label}</span>
                      <span class="series-tile-post">{s.featured.post.data.title}</span>
                    </span>
                  )}
                  <span class="series-tile-cta">Open the series -&gt;</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- 5. MENTAL PERFORMANCE PLANS (text + image right) -->
      <section class="home-band band-dark band-split" aria-labelledby="mental-heading">
        <div class="band-inner band-split-inner">
          <div class="band-text">
            <p class="band-kicker">Mental Performance Plans <span class="band-tag band-tag-paid">Paid</span> <span class="band-tag band-tag-ai">AI-generated</span></p>
            <h2 id="mental-heading">A six week mental performance plan, built around your sport.</h2>
            <p>Fill in a short intake form sharing your sport, your competitive level, the performance moments you want to work on, your peak moments, your struggle moments. Receive a structured plan that pulls from the twelve themes of the Gael Performance Toolkit. Confidence, focus, pre-performance routines, mistake recovery, self-talk, visualisation.</p>
            <p>Delivered fully online. Self-paced. Built to apply in training and on match day.</p>
            <p class="band-price"><strong>£2</strong> for the 6-week plan. A single payment, not a subscription.</p>
            <a href="/personal-training#mental-performance-plans" class="band-link">Start your mental performance plan -&gt;</a>
          </div>
          <div class="band-image">
            <Image src={mentalImage} alt="Two players embracing on the pitch" class="band-photo" loading="lazy" widths={[600, 900, 1200]} sizes="(max-width: 900px) 100vw, 50vw" />
            <PhotoCredit src={mentalImage.src} />
          </div>
        </div>
      </section>

    </main>
    <Footer />
  </body>

<style>
  .home-layout {
    padding: 0;
  }

  .home-band {
    width: 100%;
  }

  /* Champo Week band: the headline theme during championship season. Dark
     with lime accents so it reads as the loudest thing on the page. */
  /* Four series, one card each. Replaced three full-width image bands, so it
     carries the same explanation in roughly a third of the page height. */
  .series-band {
    padding: 3rem 0;
  }

  /* Light purple so the Content Hub band reads as its own zone, and the team
     photo keeps the page feeling like a real club rather than a product page. */
  .series-band {
    background: #f3e8f5;
    border-top: 3px solid rgba(105, 0, 90, 0.25);
    border-bottom: 3px solid rgba(105, 0, 90, 0.25);
  }

  .series-band .band-kicker,
  .series-band h2,
  .series-band .series-band-sub {
    color: var(--purple);
  }

  /* Photographer signature sits on the photo itself, bottom right, on every
     homepage image. Previously the credits sat underneath in different
     places depending on the band, so they read inconsistently. */
  .band-image,
  .series-band-photo,
  .champo-photo {
    position: relative;
  }

  .band-image :global(.photo-credit),
  .series-band-photo :global(.photo-credit),
  .champo-photo :global(.photo-credit) {
    position: absolute;
    right: 0.6rem;
    bottom: 0.55rem;
    margin: 0;
    padding: 0.22rem 0.6rem;
    border-radius: 999px;
    background: rgba(3, 10, 6, 0.66);
    color: rgba(244, 255, 232, 0.92) !important;
    font-size: 0.72rem;
    font-style: italic;
  }

  .series-band-photo {
    position: relative;
    margin: 0 auto 1.75rem;
    max-width: 1100px;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 14px 30px rgba(0, 0, 0, 0.22);
  }

  .series-band-img {
    display: block;
    width: 100%;
    height: clamp(180px, 28vw, 320px);
    object-fit: cover;
    object-position: center 35%;
  }

  .series-band-head {
    text-align: center;
    max-width: 60ch;
    margin: 0 auto 1.75rem;
  }

  .series-band-head h2 {
    margin: 0.4rem 0 0.5rem;
    font-size: 1.8rem;
    line-height: 1.2;
  }

  .series-band-sub {
    margin: 0;
  }

  .series-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }

  .series-tile {
    background: #ffffff;
    border: 2px solid rgba(105, 0, 90, 0.18);
    border-top: 6px solid var(--purple);
    border-radius: 14px;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }

  .series-tile:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 30px rgba(0, 0, 0, 0.18);
  }

  .series-tile a {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.15rem 1.2rem 1.25rem;
    text-decoration: none !important;
    color: inherit !important;
  }

  .series-tile-training-the-mind { border-top-color: var(--purple); }
  .series-tile-gael-performance-toolkit { border-top-color: var(--green-lime); }
  .series-tile-strong-minds-stronger-players { border-top-color: #1d6fb8; }
  .series-tile-mindfulness-and-affirmations { border-top-color: var(--mind-orange); }

  .series-tile-title {
    margin: 0 0 0.45rem;
    color: var(--green-dark);
    font-size: 1.08rem;
    line-height: 1.3;
  }

  .series-tile-blurb {
    margin: 0 0 0.9rem;
    color: var(--green-dark);
    opacity: 0.85;
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .series-tile-latest {
    display: block;
    margin-bottom: 0.8rem;
    padding: 0.55rem 0.7rem;
    border-radius: 8px;
    background: rgba(192, 254, 113, 0.22);
  }

  .series-tile-label {
    display: block;
    color: var(--purple);
    font-size: 0.68rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.07em;
  }

  .series-tile-post {
    display: block;
    color: var(--green-dark);
    font-size: 0.88rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .series-tile-cta {
    margin-top: auto;
    color: var(--purple);
    font-weight: 700;
    font-size: 0.85rem;
  }

  .champo-band {
    background: linear-gradient(180deg, rgba(3, 10, 6, 0.97) 0%, rgba(20, 8, 24, 0.95) 100%);
    border-top: 3px solid var(--green-lime);
    border-bottom: 3px solid var(--green-lime);
    padding: 3rem 0;
  }

  .champo-head {
    text-align: center;
    max-width: 62ch;
    margin: 0 auto 2rem;
  }

  .champo-eyebrow {
    margin: 0 0 0.5rem;
    display: inline-block;
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    background: var(--green-lime);
    color: var(--green-dark);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.78rem;
    font-weight: 800;
  }

  .champo-head h2 {
    margin: 0.4rem 0 0.6rem;
    color: var(--green-lime);
    font-size: 1.9rem;
    line-height: 1.2;
  }

  .champo-sub {
    margin: 0;
    color: var(--green-light);
  }

  .champo-grid {
    list-style: none;
    padding: 0;
    margin: 0 0 1.75rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
  }

  .champo-tile {
    background: #ffffff;
    border: 2px solid var(--green-lime);
    border-radius: 12px;
    padding: 1rem 1.1rem 1.1rem;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .champo-tile:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 32px rgba(0, 0, 0, 0.35);
  }

  .champo-tile a {
    display: block;
    text-decoration: none !important;
    color: inherit !important;
  }

  .champo-series {
    display: inline-block;
    margin-bottom: 0.45rem;
    padding: 0.18rem 0.55rem;
    border-radius: 999px;
    background: var(--purple);
    color: #ffffff;
    font-size: 0.68rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  /* One colour per series so the Champo Week grid reads at a glance as
     "this came from four different places". Each pairing is checked for
     contrast against its text colour. */
  .champo-series-training-the-mind {
    background: var(--purple);
    color: #ffffff;
  }

  .champo-series-gael-performance-toolkit {
    background: var(--green-lime);
    color: var(--green-dark);
  }

  .champo-series-strong-minds-stronger-players {
    background: #1d6fb8;
    color: #ffffff;
  }

  .champo-series-mindfulness-and-affirmations {
    background: var(--mind-orange-text);
    color: #ffffff;
  }

  .champo-title {
    margin: 0 0 0.4rem;
    color: var(--green-dark);
    font-size: 1.02rem;
    line-height: 1.35;
    font-weight: 700;
  }

  .champo-desc {
    margin: 0 0 0.7rem;
    color: var(--green-dark);
    opacity: 0.82;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .champo-cta {
    color: var(--purple);
    font-weight: 700;
    font-size: 0.85rem;
  }

  .champo-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    justify-content: center;
  }

  /* Series pills under the champo tiles, filled in the same colour as that
     series' tag on the tiles above. Filled rather than outlined because the
     band is dark: purple text on it is 1.67:1, whereas white on purple is
     11:1. Each pairing below is checked for contrast. */
  .champo-series-link {
    border: 2px solid transparent;
    border-radius: 999px;
    padding: 0.45rem 0.9rem;
    font-weight: 700;
    font-size: 0.88rem;
    text-decoration: none !important;
  }

  .champo-series-link-training-the-mind {
    background: var(--purple);
    color: #ffffff !important;
  }

  .champo-series-link-gael-performance-toolkit {
    background: var(--green-lime);
    color: var(--green-dark) !important;
  }

  .champo-series-link-strong-minds-stronger-players {
    background: #1d6fb8;
    color: #ffffff !important;
  }

  .champo-series-link-mindfulness-and-affirmations {
    background: var(--mind-orange-text);
    color: #ffffff !important;
  }

  .champo-series-link:hover {
    border-color: #ffffff;
  }

  .champo-series-link:focus-visible {
    outline: 3px solid #ffffff;
    outline-offset: 2px;
  }

  @media (max-width: 720px) {
    .champo-band { padding: 2rem 0; }
    .champo-head h2 { font-size: 1.45rem; }
  }

  .band-inner {
    max-width: 1380px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .home-hero {
    background:
      radial-gradient(circle at 20% 30%, rgba(105, 0, 90, 0.35) 0%, transparent 55%),
      radial-gradient(circle at 80% 70%, rgba(192, 254, 113, 0.10) 0%, transparent 55%),
      var(--green-dark);
    color: var(--green-light);
    min-height: 100vh;
    padding: 7rem 1.5rem 4rem;
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-stage-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 760px;
    margin: 0 auto;
  }

  .hero-stage {
    position: relative;
    width: clamp(260px, 28vw, 360px);
    height: clamp(260px, 28vw, 360px);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: visible;
    margin-bottom: 1.4rem;
  }

  .hero-fb {
    position: absolute;
    width: 100%;
    height: 100%;
    object-fit: contain;
    mix-blend-mode: screen;
    animation: heroFbSpin 1.5s cubic-bezier(.15, .8, .35, 1) forwards,
               heroFbFade 0.3s ease-in 1.75s forwards;
