---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Your Programme Preview | ${SITE_TITLE}`} description="A preview of your training programme. Buy to unlock the full plan." />
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="preview-page">
    <Header />
    <main class="container preview-main">
      <div class="page-hero">
        <p class="page-eyebrow">Your preview</p>
        <h1>Your Plan Preview</h1>
        <p class="page-sub">An outline of the 6-week mental performance plan built from the intake form. The full plan, week by week, unlocks after payment.</p>
      </div>

      <section class="preview-status panel" id="preview-status">
        <p>Loading your preview...</p>
      </section>

      {/* White card with the purple top edge, the same surface as the About
          and Content Hub cards, instead of a lime outline on black. */}
      <section class="preview-content-wrap panel" id="preview-content-wrap" hidden>
        <div class="watermark" id="preview-watermark" aria-hidden="true"></div>
        <article class="preview-content" id="preview-content"></article>
      </section>

      <section class="preview-cta" id="preview-cta" hidden>
        <p class="page-eyebrow">£2 · single payment</p>
        <h2>Unlock the full plan</h2>
        <p>The full plan is emailed as a PDF within minutes of payment and saved to your dashboard.</p>
        <div class="cta-buttons">
          <a id="buy-6-week" class="cta-button cta-primary" href="#">Buy 6-Week Programme</a>
        </div>
        <p class="cta-footnote">Questions first? Email Emily at <a href="mailto:emilyphelan@mindthegael.co.uk">emilyphelan@mindthegael.co.uk</a>.</p>
      </section>
    </main>
    <Footer />

    <script is:inline>
      function renderTeaser(root, text) {
        root.textContent = '';
        let list = null;
        const clean = (t) => t.replace(/\*\*(.+?)\*\*/g, '$1').replace(/^\*|\*$/g, '').trim();
        for (const raw of text.split(/\r?\n/)) {
          const line = raw.trim();
          if (!line) { list = null; continue; }
          const heading = line.match(/^(#{1,4})\s+(.*)$/);
          const bullet = line.match(/^(?:[-*•]|\d+[.)])\s+(.*)$/);
          if (heading) {
            list = null;
            const h = document.createElement(heading[1].length <= 1 ? 'h2' : 'h3');
            // The prompt asks for upper-case section headers; sentence case
            // reads as part of the site rather than shouting.
            const t = clean(heading[2]);
            h.textContent = t === t.toUpperCase() ? t.charAt(0) + t.slice(1).toLowerCase() : t;
            root.appendChild(h);
          } else if (bullet) {
            if (!list) { list = document.createElement('ul'); root.appendChild(list); }
            const li = document.createElement('li');
            li.textContent = clean(bullet[1]);
            list.appendChild(li);
          } else {
            list = null;
            const p = document.createElement('p');
            p.textContent = clean(line);
            root.appendChild(p);
          }
        }
      }

      (async () => {
        const params = new URLSearchParams(window.location.search);
        const token = params.get('token');
        const statusEl = document.getElementById('preview-status');
        const contentWrap = document.getElementById('preview-content-wrap');
        const contentEl = document.getElementById('preview-content');
        const watermarkEl = document.getElementById('preview-watermark');
        const ctaEl = document.getElementById('preview-cta');
        const buy6 = document.getElementById('buy-6-week');

        if (!token) {
          if (statusEl) statusEl.innerHTML = '<p class="error-message">No preview token in the URL. Please fill in the intake form on <a href="/personal-training">the personal training page</a> to start.</p>';
          return;
        }

        try {
          const res = await fetch('/api/programme-preview?token=' + encodeURIComponent(token));
          const data = await res.json();

          if (!res.ok) {
            if (statusEl) statusEl.innerHTML = '<p class="error-message">' + (data.error || 'Unable to load preview.') + '</p>';
            return;
          }

          // Hide loading state, show content and CTAs.
          if (statusEl) statusEl.hidden = true;
          if (contentEl) {
            // Build real headings, lists and paragraphs from the model's
            // markdown. Every node is made with createElement and filled with
            // textContent, so the teaser still never renders as HTML.
            renderTeaser(contentEl, data.teaserContent || '');
          }
          if (watermarkEl) {
            // Watermark uses the client's email so any screenshot is
            // traceable to them.
            watermarkEl.textContent = data.clientEmail || '';
          }
          if (contentWrap) contentWrap.hidden = false;
          if (ctaEl) ctaEl.hidden = false;

          // Wire the Buy button to carry the token through Stripe. The mental
          // performance plan is the only paid product now, so there is no
          // longer a plan type to branch on. The £10 physical plan was retired
          // in create-checkout-session.ts and pointing at it here would fail
          // the VALID_PLANS check.
          if (buy6 instanceof HTMLAnchorElement) {
            buy6.href = '/api/create-checkout-session?plan=mental-6-week&token=' + encodeURIComponent(token);
            buy6.textContent = 'Buy 6-Week Mental Plan';
          }
        } catch (err) {
          console.error('Preview load error:', err);
          if (statusEl) statusEl.innerHTML = '<p class="error-message">Unable to load preview. Please try refreshing the page.</p>';
        }
      })();

      // ── Deterrents (friction layers, not true protection) ──

      // Disable right-click context menu on the preview content.
      document.addEventListener('contextmenu', (e) => {
        const target = e.target;
        if (target instanceof Element && target.closest('.preview-content')) {
          e.preventDefault();
        }
      });

      // Disable Ctrl/Cmd+P (print) and Ctrl/Cmd+S (save).
      document.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && (e.key === 'p' || e.key === 'P')) {
          e.preventDefault();
        }
        if ((e.ctrlKey || e.metaKey) && (e.key === 's' || e.key === 'S')) {
          e.preventDefault();
        }
      });

      // Blur preview content when the window loses focus, to make
      // quick screenshot-then-switch-tab attempts visible.
      window.addEventListener('blur', () => {
        document.body.classList.add('window-blurred');
      });
      window.addEventListener('focus', () => {
        document.body.classList.remove('window-blurred');
      });
    </script>
  </body>
</html>

<style>
  .preview-main {
    padding-bottom: 3rem;
  }

  .preview-status p {
    margin: 0;
  }

  /* :global because these messages are written with innerHTML, so they
     never carry the data-astro-cid attribute a scoped selector needs. */
  .preview-status :global(a) {
    color: var(--purple) !important;
    font-weight: 700;
    text-decoration: underline;
  }

  .preview-content-wrap {
    position: relative;
    overflow: hidden;
  }

  .preview-content {
    position: relative;
    z-index: 1;
    line-height: 1.65;
    color: #222;

    /* Deterrent 1: disable text selection. */
    user-select: none;
    -webkit-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;

    /* Deterrent 2: prevent drag-saving of the content as text. */
    -webkit-user-drag: none;
  }

  /* Written by renderTeaser, so :global for the same reason as above. */
  .preview-content :global(h2) {
    color: var(--purple);
    font-size: 1.3rem;
    margin: 1.6rem 0 0.6rem;
    padding-bottom: 0.4rem;
    border-bottom: 2px solid var(--green-lime);
  }

  .preview-content :global(h2:first-child) {
    margin-top: 0;
  }

  .preview-content :global(h3) {
    color: var(--purple);
    font-size: 1.05rem;
    margin: 1.1rem 0 0.4rem;
  }

  .preview-content :global(p) {
    margin: 0 0 0.8rem;
  }

  .preview-content :global(ul) {
    margin: 0 0 1rem;
    padding-left: 1.3rem;
  }

  .preview-content :global(li) {
    margin: 0 0 0.35rem;
  }

  .preview-content :global(li::marker) {
    color: var(--purple);
  }

  /* Deterrent 3: visible diagonal watermark with the client's email,
     so any screenshot is traceable to the person who saw it. */
  .watermark {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    color: rgba(105, 0, 90, 0.16);
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    transform: rotate(-30deg);
    z-index: 2;
    user-select: none;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
  }

  /* Deterrent 4: blur the preview when the window loses focus
     (deters the quick screenshot-then-switch-tab move). */
  body.window-blurred .preview-content {
    filter: blur(8px);
    transition: filter 0.05s linear;
  }

  /* Deterrent 5: hide the preview entirely when printing. */
  @media print {
    .preview-content,
    .preview-content-wrap {
      display: none !important;
    }
    body::before {
      content: "Printing the preview is not allowed. Buy the programme to receive the full plan by email.";
      display: block;
      padding: 2rem;
      font-size: 1.2rem;
    }
  }

  /* Dark purple band with a lime edge, echoing the home page's
     Championship section, so the one call to action stands apart from the
     white preview card above it. */
  .preview-cta {
    max-width: 760px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    border-radius: 14px;
    border: 3px solid var(--green-lime);
    background: linear-gradient(180deg, rgba(105, 0, 90, 0.92) 0%, rgba(40, 6, 36, 0.95) 100%);
    color: var(--green-light);
    text-align: center;
  }

  .preview-cta h2 {
    margin: 0 0 0.6rem;
    color: var(--green-lime);
    font-size: 1.7rem;
  }

  .preview-cta p {
    margin: 0 auto 1.2rem;
    max-width: 48ch;
  }

  .preview-cta .page-eyebrow {
    margin-bottom: 0.9rem;
  }

  .cta-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin-bottom: 1rem;
  }

  /* The global `main a` rule sets dark purple on every anchor inside
     <main>, so each anchor colour here needs !important to win. */
  .cta-button {
    display: inline-block;
    padding: 0.85rem 1.5rem;
    border-radius: 8px;
    border: 2px solid var(--green-lime);
    font-weight: 800;
    font-size: 1.05rem;
    text-decoration: none !important;
    transition: transform 0.15s ease, background-color 0.15s ease, color 0.15s ease;
  }

  .cta-primary {
    background: var(--green-lime);
    color: var(--green-dark) !important;
  }

  .cta-button:hover {
    transform: translateY(-1px);
    background: var(--purple-light);
    border-color: var(--purple-light);
    color: var(--green-dark) !important;
  }

  .cta-footnote {
    font-size: 0.9rem;
    opacity: 0.9;
    margin-bottom: 0 !important;
  }

  .cta-footnote a {
    color: #ffffff !important;
    text-decoration: underline !important;
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .cta-footnote a:hover {
    color: var(--green-lime) !important;
  }

  /* Written with innerHTML into the white status card. */
  .preview-status :global(.error-message) {
    color: #8a0015;
    margin: 0;
  }
</style>
