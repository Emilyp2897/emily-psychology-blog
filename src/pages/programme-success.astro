---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import mtgLogo from '../assets/MTG_colour.png';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Payment Confirmed | ${SITE_TITLE}`} description="Your programme has been purchased. Next step: fill in your intake form." />
  </head>
  <body>
    <Header />
    <main class="container">
      <section class="status-band">
        <div class="status-band-inner">
          <Image src={mtgLogo} alt="" class="status-logo" loading="eager" aria-hidden="true" />
          <p class="status-eyebrow" id="status-eyebrow">Finalising your plan</p>
          <h1 id="status-heading">Hold on a moment</h1>
          <p class="status-message" id="status-message">Stripe confirmed your payment. I'm now generating your plan. This usually takes under a minute.</p>
          <p class="status-message" id="status-followup" hidden></p>
          <div class="status-progress" id="status-progress" role="status" aria-label="Generating your plan">
            <span class="status-progress-fill"></span>
          </div>
          <div class="status-actions" id="status-actions" hidden>
            <a href="/dashboard" class="status-action-primary">Go to your dashboard</a>
            <a href="/contact-us" class="status-action-secondary">Need help?</a>
          </div>
          <p class="status-footnote">A receipt for your payment will arrive in your email from Stripe. If you don't see it, check your spam folder.</p>
        </div>
      </section>
    </main>
    <Footer />

    <script is:inline>
      // Call /api/programme-finalize to verify Stripe payment and generate
      // the full plan. The intake data is already in the database (saved
      // when the user submitted the intake form earlier); the token tells
      // the API which intake to use.
      (async () => {
        const params = new URLSearchParams(window.location.search);
        const sessionId = params.get('session_id');
        const token = params.get('token');

        const eyebrow = document.getElementById('status-eyebrow');
        const heading = document.getElementById('status-heading');
        const message = document.getElementById('status-message');
        const followup = document.getElementById('status-followup');
        const actions = document.getElementById('status-actions');
        const progress = document.getElementById('status-progress');

        const showSuccess = (text) => {
          if (eyebrow) eyebrow.textContent = 'Plan ready';
          if (heading) heading.textContent = 'Your plan is ready';
          if (message) message.textContent = 'Redirecting you to your dashboard...';
              setTimeout(() => {
              window.location.href = '/dashboard';
      }, 2000);
};

        const showError = (text, followupText) => {
          // Nothing is in progress any more, so the bar would be claiming
          // work that has already stopped.
          if (progress) progress.hidden = true;
          if (eyebrow) eyebrow.textContent = 'Something went wrong';
          if (heading) heading.textContent = 'We could not finalise your plan';
          if (message) message.textContent = text;
          if (followupText && followup) {
            followup.textContent = followupText;
            followup.hidden = false;
          }
          if (actions) actions.hidden = false;
        };

        if (!sessionId || !token) {
          showError(
            'Missing session or intake token in the URL.',
            'If you have just paid and your plan has not arrived within 10 minutes, please email Emily directly at emilyphelan@mindthegael.co.uk with a note about your purchase.'
          );
          return;
        }

        try {
          const res = await fetch('/api/programme-finalize', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ sessionId, token }),
          });
          const data = await res.json().catch(() => ({}));

          if (!res.ok || !data.success) {
            showError(
              data.error || 'We could not finalise your plan automatically.',
              'Please email Emily at emilyphelan@mindthegael.co.uk and include the words "session ' + sessionId + '" so she can look it up.'
            );
            return;
          }

          // The API sends the accurate message for this plan, which differs
          // depending on whether it sent automatically or is waiting on Emily.
          // This fallback only shows if that message is missing, so it states
          // the common case: the plan is already in the dashboard.
          showSuccess(data.message || 'Your plan has been generated and is waiting in your dashboard.');
        } catch (err) {
          console.error('Finalize error:', err);
          showError(
            'A network error stopped us from finalising your plan automatically.',
            'Please email Emily at emilyphelan@mindthegael.co.uk and mention session ' + sessionId + '.'
          );
        }
      })();
    </script>
  </body>
</html>

