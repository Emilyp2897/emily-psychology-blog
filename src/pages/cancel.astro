---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import mtgLogo from '../assets/MTG_colour.png';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Checkout Canceled | ${SITE_TITLE}`} description="Your checkout was canceled. You can return to subscriptions anytime." />
  </head>
  <body>
    <Header />
    <main class="container">
      <section class="status-band">
        <div class="status-band-inner">
          <Image src={mtgLogo} alt="" class="status-logo" loading="eager" aria-hidden="true" />
          <p class="status-eyebrow">No payment taken</p>
          <h1>Checkout canceled</h1>
          <p class="status-message">No problem. Your subscription was not completed, and you were not charged.</p>
          <p class="status-message">You can return and subscribe anytime when you are ready.</p>
          <div class="status-actions">
            <a href="/api/create-checkout-session?plan=individual" class="status-action-primary">Try again</a>
            <a href="/contact-us" class="status-action-secondary">Talk to us</a>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>

