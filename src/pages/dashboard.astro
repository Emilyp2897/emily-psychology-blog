---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`My Dashboard | ${SITE_TITLE}`} description="Your Mind the Gael performance plans." />
  </head>
  <body>
    <Header />
    <main class="container">
      {/* Hidden until the sign-in check passes. The session lives in
          localStorage, so the server cannot know who you are before it
          sends this page: without this, a logged-out visitor was shown
          "My Dashboard", "Welcome back." and a Log Out button while the
          browser worked out they were not signed in. */}
      <div class="dashboard-wrap" id="dashboard-wrap" hidden>
        <div class="page-hero">
          <p class="page-eyebrow">Your account</p>
          <h1>My Dashboard</h1>
          <p class="page-sub" id="dashboard-greeting">Welcome back.</p>
          <button id="logout-btn" class="logout-btn">Log Out</button>
        </div>

        <section class="plans-section">
          <h2>Your Plans</h2>
          <p class="dashboard-ai-note">
            <strong>About your plans:</strong> Each plan is written by AI from your intake answers and sent to you automatically, so no one reads it before you do. AI can get things wrong. If anything in a plan looks off, unclear, or unsafe, stop and <a href="/contact-us">message Emily</a> rather than pushing through it.
          </p>
          <div id="plans-list" class="plans-list">
            <p class="plans-empty">Loading your plans...</p>
          </div>
        </section>

        <nav class="dashboard-links" aria-label="More from Mind the Gael">
          <a href="/personal-training" class="dashboard-link">Start a new plan</a>
          <a href="/content-hub" class="dashboard-link">Content Hub</a>
          <a href="/contact-us" class="dashboard-link">Contact Emily</a>
        </nav>
      </div>
    </main>
    <Footer />

    <script>
      import { supabase, getUserOrThrow, getAccessTokenOrThrow } from '../lib/supabase.js';

      const plansList = document.getElementById('plans-list');

      // Every failure path below has to reach the screen. This page used to
      // sit on the "Loading your plans..." placeholder forever whenever the
      // auth call hung, which made a stalled session indistinguishable from
      // a slow one, with nothing in the console either way.
      function showError(message: string) {
        if (!plansList) return;
        plansList.innerHTML =
          `<p class="plans-empty">${message} Try refreshing, or ` +
          `<a href="/login">sign in again</a>.</p>`;
      }

      // Check user is logged in. getUserOrThrow times out rather than
      // hanging, so a stuck auth lock surfaces as an error instead of a
      // permanently frozen page.
      let user: any = null;
      try {
        user = await getUserOrThrow();
      } catch (err: any) {
        // supabase-js reports "not signed in" by throwing, not by returning
        // null, so the two cases arrive here together and have to be told
        // apart. Being signed out is ordinary: redirect, and leave the page
        // hidden so a stranger never sees the dashboard shell.
        const noSession =
          err?.name === 'AuthSessionMissingError' ||
          /auth session missing/i.test(err?.message || '');
        if (noSession) {
          window.location.href = '/login';
          // Stop here without throwing. A module script cannot return at
          // the top level, and the rest of the file must not run against a
          // null user, but an uncaught throw shows up as a red error in the
          // console for what is an ordinary redirect. Awaiting a promise
          // that never settles halts this script while the browser
          // navigates away.
          await new Promise(() => {});
        }
        // A real failure, a timeout say, where the session may well be fine.
        // showError writes inside the wrapper, so reveal it first or the
        // page just looks blank.
        console.error('dashboard auth check failed:', err);
        document.getElementById('dashboard-wrap')?.removeAttribute('hidden');
        showError(`We could not confirm your sign-in: ${err?.message || 'Unknown error'}.`);
        throw err;
      }

      if (!user) {
        window.location.href = '/login';
        // A module script cannot return at the top level, and without this
        // the rest of the file kept running against a null user while the
        // browser was still navigating.
        // Stop here without throwing. A module script cannot return at
        // the top level, and the rest of the file must not run against a
        // null user, but an uncaught throw shows up as a red error in the
        // console for what is an ordinary redirect. Awaiting a promise
        // that never settles halts this script while the browser
        // navigates away.
        await new Promise(() => {});
      }

      // Signed in and confirmed, so the page can be shown.
      document.getElementById('dashboard-wrap')?.removeAttribute('hidden');

      // Greet the user
      const greeting = document.getElementById('dashboard-greeting');
      const name = user?.user_metadata?.full_name || user?.email;
      if (greeting) greeting.textContent = `Welcome back, ${name}.`;


      // Logout
      const logoutBtn = document.getElementById('logout-btn');
      logoutBtn?.addEventListener('click', async () => {
        await supabase.auth.signOut();
        window.location.href = '/login';
      });

      // Load plans via the server-side endpoint so we can include team
      // plans (which have user_id = null and would otherwise be hidden
      // by RLS on the client-facing supabase client).
      let accessToken: string | null = null;
      try {
        accessToken = await getAccessTokenOrThrow();
      } catch (err: any) {
        console.error('dashboard session lookup failed:', err);
        showError(`We could not read your session: ${err?.message || 'Unknown error'}.`);
        throw err;
      }

      if (!accessToken) {
        window.location.href = '/login';
        // Stop here without throwing. A module script cannot return at
        // the top level, and the rest of the file must not run against a
        // null user, but an uncaught throw shows up as a red error in the
        // console for what is an ordinary redirect. Awaiting a promise
        // that never settles halts this script while the browser
        // navigates away.
        await new Promise(() => {});
      }

      // loadFailed keeps a failed request from falling through to the
      // "You have no active plans yet" branch below. An error and an empty
      // account used to render identically, so a broken load looked like a
      // customer with nothing bought.
      let allPlans: any[] = [];
      let loadFailed = false;
      try {
        const res = await fetch('/api/customer-plans', {
          headers: { 'Authorization': `Bearer ${accessToken}` },
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && Array.isArray(data?.plans)) {
          allPlans = data.plans;
        } else {
          loadFailed = true;
          console.error('customer-plans returned non-ok:', res.status, data);
          showError(`We could not load your plans: ${data?.error || 'Request failed'} (HTTP ${res.status}).`);
        }
      } catch (err: any) {
        loadFailed = true;
        console.error('customer-plans fetch failed', err);
        showError(`We could not load your plans: ${err?.message || 'Network error'}.`);
      }

      function statusLabel(plan: any): string {
        if (plan.is_team_plan && plan.status === 'pending_review') return 'pending review';
        return plan.status;
      }

      function planLink(plan: any): string | null {
        if (plan.is_team_plan) {
          // Only link if approved + has a share token. Pending team
          // plans have no public URL yet.
          if (plan.status === 'active' && plan.share_token) return `/team-plan/${plan.share_token}`;
          return null;
        }
        return `/plan/${plan.id}`;
      }

      function planTypeLabel(plan: any): string {
        const base = plan.plan_type === 'mental' ? '🧠 Mental Performance Plan' : '💪 Physical Performance Plan';
        return plan.is_team_plan ? `${base} <span class="team-badge">Team</span>` : base;
      }

      if (loadFailed) {
        // showError already wrote the reason into plansList. Leave it.
      } else if (allPlans.length === 0) {
        // Relative href and no inline colour. The absolute URL broke the
        // empty state on local and preview builds by sending you to
        // production, and the inline lime was the last thing overriding the
        // panel styling in the stylesheet below.
        if (plansList) plansList.innerHTML = '<p class="plans-empty">You have no active plans yet. <a href="/personal-training">Get started here.</a></p>';
      } else {
        if (plansList) {
          plansList.innerHTML = allPlans.map((plan: any) => {
            const link = planLink(plan);
            const ctaHtml = link
              ? `<a href="${link}" class="plan-view-btn">${plan.is_team_plan ? 'Open team plan' : 'View Plan'}</a>`
              : `<span class="plan-pending-note">Awaiting Emily's review. You'll get an email with the share link once it's live.</span>`;
            return `
              <div class="plan-card">
                <div class="plan-card-header">
                  <span class="plan-type">${planTypeLabel(plan)}</span>
                  <span class="plan-status ${plan.status}">${statusLabel(plan)}</span>
                </div>
                <p class="plan-date">Created ${new Date(plan.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</p>
                ${ctaHtml}
              </div>
            `;
          }).join('');
        }
      }
    </script>

    <style>
      .dashboard-wrap {
        max-width: 860px;
        margin: 0 auto 3rem;
      }

      /* Outline on the dark header: Log Out is secondary, so it stays quiet
         and leaves the filled button on each plan card as the main action. */
      .logout-btn {
        margin-top: 0.6rem;
        padding: 0.45rem 1rem;
        background: transparent;
        border: 2px solid var(--green-lime);
        color: var(--green-light);
        border-radius: 8px;
        font: inherit;
        font-size: 0.85rem;
        font-weight: 700;
        cursor: pointer;
        transition: border-color 0.15s ease, color 0.15s ease;
      }

      .logout-btn:hover {
        border-color: var(--purple-light);
        color: var(--purple-light);
      }

      .logout-btn:focus-visible {
        outline: 3px solid var(--purple-light);
        outline-offset: 2px;
      }

      .plans-section h2 {
        color: var(--green-lime);
        font-size: 1.5rem;
        margin: 0 0 0.8rem;
      }

      /* Light lilac panel, matching the notices on pricing and personal
         training. It was lime on a dark green tint. */
      .dashboard-ai-note {
        background: #f9effd;
        border: none;
        border-left: 5px solid var(--purple);
        border-radius: 0 10px 10px 0;
        padding: 0.85rem 1.1rem;
        margin: 0 0 1.25rem;
        font-size: 0.88rem;
        line-height: 1.5;
        color: #1a1a1a;
      }

      /* One rule for the link, not two. There were two `.dashboard-ai-note a`
         blocks: the panel had already been changed from a dark green tint to
         light lilac and the link to purple, but the old lime rule was left
         below it and won on source order. That put lime green text on a light
         lilac panel, which is where "message Emily" went unreadable. */
      .dashboard-ai-note a {
        color: var(--purple) !important;
        text-decoration: underline !important;
        font-weight: 700;
      }

      .dashboard-ai-note a:hover {
        color: var(--purple-deep, #4a0040) !important;
      }

      .dashboard-ai-note strong {
        color: var(--purple);
        font-weight: 700;
        margin-right: 0.3rem;
      }

      /* Two cards a row once there is room, like the Content Hub grid. */
      .plans-list {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
        gap: 1.1rem;
      }

      .plans-list :global(.plans-empty) {
        grid-column: 1 / -1;
      }

      /* The empty and error states used to be bare text on the dark page with
         a lime link. They are now the same lilac panel as the note above, so
         the column reads as one set of cards whatever state it is in. */
      .plans-list :global(.plans-empty) {
        margin: 0;
        padding: 1rem 1.2rem;
        border-left: 4px solid var(--purple);
        border-radius: 0 10px 10px 0;
        background: #f9effd;
        color: #1a1a1a;
        font-size: 0.95rem;
      }

      .plans-list :global(.plans-empty a) {
        color: var(--purple) !important;
        text-decoration: underline;
        font-weight: 700;
      }

      /* The About page's card: white, lilac edge, heavy purple top. */
      .plans-list :global(.plan-card) {
        background: #ffffff;
        border: 2px solid var(--purple-light);
        border-top: 6px solid var(--purple);
        border-radius: 14px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
        padding: 1.3rem 1.4rem;
        display: grid;
        gap: 0.6rem;
        align-content: start;
      }

      .plans-list :global(.plan-card-header) {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 0.75rem;
      }

      .plans-list :global(.plan-type) {
        font-weight: 800;
        color: var(--purple);
        font-size: 1.1rem;
        line-height: 1.3;
      }

      /* Purple tint rather than a lime one. Lime at 20% on white is barely a
         colour, so the status pill read as a grey smudge. */
      .plans-list :global(.plan-status) {
        font-size: 0.78rem;
        font-weight: 800;
        padding: 0.2rem 0.65rem;
        border-radius: 999px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        background: rgba(105, 0, 90, 0.1);
        color: var(--purple);
        white-space: nowrap;
      }

      .plans-list :global(.plan-date) {
        color: #666;
        font-size: 0.85rem;
        margin: 0;
      }

      /* Filled purple: the one primary action on the card. */
      .plans-list :global(.plan-view-btn) {
        display: inline-block;
        margin-top: 0.25rem;
        padding: 0.55rem 1rem;
        background: var(--purple);
        border: 2px solid var(--purple);
        color: #ffffff !important;
        font-weight: 700;
        font-size: 0.9rem;
        border-radius: 8px;
        text-decoration: none !important;
        width: fit-content;
        transition: background 0.15s ease, color 0.15s ease;
      }

      .plans-list :global(.plan-view-btn:hover) {
        background: #ffffff;
        color: var(--purple) !important;
      }

      .plans-list :global(.plan-view-btn:focus-visible) {
        outline: 3px solid var(--purple-light);
        outline-offset: 2px;
      }

      .plans-list :global(.team-badge) {
        display: inline-block;
        margin-left: 0.4rem;
        padding: 0.1rem 0.5rem;
        background: var(--purple);
        color: #ffffff;
        font-size: 0.65rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        border-radius: 999px;
        vertical-align: middle;
      }

      /* Lime pill on the active status, so a live plan reads at a glance. */
      .plans-list :global(.plan-status.active) {
        background: var(--green-lime);
        color: var(--green-dark);
      }

      .dashboard-links {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.75rem;
        margin-top: 2.5rem;
      }

      .dashboard-link {
        padding: 0.55rem 1.1rem;
        border-radius: 999px;
        border: 2px solid var(--green-lime);
        color: var(--green-light) !important;
        font-weight: 700;
        font-size: 0.9rem;
        text-decoration: none !important;
        transition: border-color 0.15s ease, color 0.15s ease;
      }

      .dashboard-link:hover {
        border-color: var(--purple-light);
        color: var(--purple-light) !important;
      }

      .plans-list :global(.plan-pending-note) {
        display: inline-block;
        margin-top: 0.25rem;
        padding: 0.5rem 0.75rem;
        background: rgba(105, 0, 90, 0.08);
        border-left: 3px solid var(--purple);
        border-radius: 6px;
        color: #555;
        font-size: 0.85rem;
        max-width: 100%;
      }
      
    </style>
  </body>
</html>