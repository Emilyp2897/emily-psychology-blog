---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FullPage from './_performance-plans-full.astro';
import { PERFORMANCE_PLANS_OPEN, SITE_TITLE } from '../consts';
---

{PERFORMANCE_PLANS_OPEN ? (
  <FullPage />
) : (
  <html lang="en">
    <head>
      <BaseHead title={`Performance Plans | ${SITE_TITLE}`} description="Mental performance plans for female athletes. Coming soon." />
    </head>
    <body class="personal-training-page">
      <Header />
      <main class="container">
        <div class="page-hero">
          <p class="page-eyebrow">Coming soon</p>
          <h1>Performance Plans</h1>
          <p class="page-sub">Personalised 6-week mental performance plans for female athletes. The plans are being rebuilt and will reopen on this page.</p>
        </div>

        <section class="panel coming-soon">
          <h2>In the meantime</h2>
          <p>Every article, toolkit and practice in the Content Hub is free.</p>
          <div class="coming-soon-actions">
            <a href="/content-hub" class="cs-primary">Go to the Content Hub</a>
            <a href="/contact-us" class="cs-secondary">Contact Emily</a>
          </div>
        </section>
      </main>
      <Footer />
    </body>
  </html>
)}

<style>
  .coming-soon {
    max-width: 560px;
    text-align: center;
    margin-bottom: 4rem;
  }

  .coming-soon h2 {
    margin: 0 0 0.5rem;
  }

  .coming-soon p {
    margin: 0 0 1.4rem;
  }

  .coming-soon-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  /* `main a` and `.panel a` set purple underlined links, so both buttons
     override colour and decoration explicitly. */
  .coming-soon-actions a {
    padding: 0.7rem 1.2rem;
    border-radius: 8px;
    font-weight: 800;
    text-decoration: none !important;
    border: 2px solid var(--purple);
  }

  .cs-primary {
    background: var(--purple);
    color: #fff !important;
  }

  .cs-secondary {
    background: #fff;
    color: var(--purple) !important;
  }

  .coming-soon-actions a:hover {
    transform: translateY(-1px);
  }
</style>
