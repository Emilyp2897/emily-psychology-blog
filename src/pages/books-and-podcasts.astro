---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import saoirseImage from '../assets/saoirse.png';
import { SITE_TITLE } from '../consts';

// Only things Emily has actually read or listened to go on this page.
// It is a recommendations list, not a reading list scraped from somewhere,
// so an entry earns its place by someone getting something out of it.
// Add to `books` / `podcasts` / `articles` below; empty sections hide
// themselves rather than showing "coming soon" placeholders.
type Topic = 'sports-psychology' | 'mental-health';

type Recommendation = {
  title: string;
  author: string;
  year?: string;
  /**
   * Which of the two shelves this belongs on. Someone arriving here wants
   * either the sport side or the mental health side, so topic is the first
   * split and format (book vs podcast) is the second.
   */
  topic: Topic;
  /**
   * ISBN-13, no hyphens. Used to pull the cover from Open Library, which
   * publishes covers as a free service specifically for linking to.
   * Leave it off and the card falls back to a typographic cover.
   */
  isbn?: string;
  /** Where to send people. Amazon for books, the show's own page for podcasts. */
  link?: string;
  /**
   * What the book or podcast actually is. A description of the thing, not a
   * review of it and not an interpretation of what you will get out of it.
   */
  note: string;
};

// `default=false` matters: without it Open Library returns a blank 1x1 image
// for a cover it does not have, which would sit there as an empty grey box.
// With it, a missing cover 404s, the onerror handler fires, and the card
// falls back to the typographic cover underneath.
const coverUrl = (isbn: string) =>
  `https://covers.openlibrary.org/b/isbn/${isbn}-L.jpg?default=false`;

const books: Recommendation[] = [
  {
    title: 'Reasons to Stay Alive',
    author: 'Matt Haig',
    year: '2015',
    topic: 'mental-health',
    isbn: '9781782115083',
    link: 'https://www.amazon.co.uk/Reasons-Stay-Alive-Matt-Haig/dp/1782115080',
    note: 'A memoir about the breakdown Haig had at 24 and living with depression since. Written in short chapters and lists rather than continuous prose.',
  },
  {
    title: 'The Chimp Paradox',
    author: 'Prof Steve Peters',
    year: '2012',
    topic: 'sports-psychology',
    isbn: '9780091935580',
    link: 'https://www.amazon.co.uk/dp/009193558X',
    note: 'A mind management model splitting the brain into the Chimp, which reacts on emotion, and the Human, which reasons. Peters is a psychiatrist who worked with British Cycling.',
  },
];

const podcasts: Recommendation[] = [
  {
    title: 'Sports Psychology Coaching',
    author: 'Eli Straw',
    topic: 'sports-psychology',
    link: 'https://www.successstartswithin.com/sports-psychology-podcast/',
    note: 'A podcast on confidence, performance anxiety, focus and pressure in sport. Episodes run 15 to 30 minutes.',
  },
];

const articles: Recommendation[] = [];

// Topic first, format second. Both levels drop out when empty, so a shelf
// with no podcasts yet shows only its books, and a topic with nothing on it
// at all does not render a bare heading.
const formats = [
  { key: 'books', label: 'Book', items: books },
  { key: 'podcasts', label: 'Podcast', items: podcasts },
  { key: 'articles', label: 'Article', items: articles },
];

const topics = [
  {
    key: 'sports-psychology',
    heading: 'Sports Psychology',
    blurb: 'Confidence, pressure and focus.',
  },
  {
    key: 'mental-health',
    heading: 'Mental Health',
    blurb: 'Anxiety, depression and recovery.',
  },
].map((topic) => ({
  ...topic,
  // One flat list per topic rather than a stack of format groups. With one
  // or two entries per format, separate groups put each entry on its own
  // row; a single grid keeps them side by side. The format is a tag on the
  // card instead.
  items: formats.flatMap((format) =>
    format.items
      .filter((item) => item.topic === topic.key)
      .map((item) => ({ ...item, format: format.key, formatLabel: format.label }))
  ),
})).filter((topic) => topic.items.length > 0);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Books & Podcasts | ${SITE_TITLE}`}
      description="Books, podcasts and articles on mental health, mental wellbeing and performance psychology. Everything here has been read or listened to by players."
    />
  </head>
  <body class="reading-page">
    <Header />

    <main class="container reading-main">
      <section class="reading-hero">
        <h1>Books &amp; Podcasts</h1>
        <p class="reading-intro">
          Books, podcasts and articles on mental health, mental wellbeing and performance psychology. Everything here has been read or listened to by players.
        </p>
      </section>

      {/* Everything sits on one Book List card: lilac surface, purple top
          edge, logo, eyebrow and title, with the topic and format splits as
          headings inside it rather than as separate cards. */}
      <section class="deck-card deck-card-reading" aria-labelledby="reading-card-heading">
        <div class="deck-head">
          <img class="deck-logo" src="/assets/MTG_colour.png" alt="" aria-hidden="true" />
          <div class="deck-head-text">
            {/* One name for this, not two. The card carried the eyebrow
                "Reading list" above the heading "Book List", which are the
                same thing said twice. */}
            <h2 id="reading-card-heading" class="deck-series">Reading List</h2>
          </div>
        </div>

        {topics.map((topic) => (
          <div class="reading-topic">
            <h3 class="reading-topic-heading">{topic.heading}</h3>
            <p class="reading-topic-blurb">{topic.blurb}</p>

            <ul class="reading-list">
                  {topic.items.map((item) => (
                <li class:list={["reading-card", `reading-card-${item.format}`]}>
                  {/* The typographic cover sits underneath as real content, not
                      as a background image, so it is what you see if Open
                      Library is down or has no cover for this edition. */}
                  <div class="cover-frame">
                    <div class="cover-fallback" aria-hidden="true">
                      <span class="cover-fallback-title">{item.title}</span>
                      <span class="cover-fallback-author">{item.author}</span>
                    </div>
                    {item.isbn && (
                      <img
                        class="cover-img"
                        src={coverUrl(item.isbn)}
                        alt={`Cover of ${item.title} by ${item.author}`}
                        loading="lazy"
                        onerror="this.remove()"
                      />
                    )}
                  </div>

                  <div class="reading-body">
                    <span class="reading-format-tag">{item.formatLabel}</span>
                    <h4 class="reading-title">{item.title}</h4>
                    <p class="reading-byline">
                      {item.author}{item.year ? ` · ${item.year}` : ''}
                    </p>
                    <p class="reading-note">{item.note}</p>
                    {item.link && (
                      <a class="reading-link" href={item.link} target="_blank" rel="noopener noreferrer">
                        {item.format === 'podcasts' ? 'Listen' : 'Buy on Amazon'}
                        <span class="reading-link-ext" aria-hidden="true">↗</span>
                        <span class="visually-hidden">(opens in a new tab)</span>
                      </a>
                    )}
                  </div>
                </li>
                  ))}
            </ul>
          </div>
        ))}
      </section>

      {/* Saoirse asks for recommendations, rather than a bordered banner with
          a heading in it. The ask is one short line, so it did not need a
          section heading and a panel around it. Same speech-bubble pattern as
          the series pages. */}
      <section class="reading-ask" aria-labelledby="heading-ask">
        <h2 id="heading-ask" class="visually-hidden">Got one that helped you?</h2>
        <Image src={saoirseImage} alt="" class="saoirse-avatar" aria-hidden="true" loading="lazy" />
        <div class="saoirse-bubble">
          <p class="reading-ask-copy">Got one that helped you? Send it on and say what it did for you.</p>
          <a class="reading-ask-link" href="mailto:emilyphelan@mindthegael.co.uk">emilyphelan@mindthegael.co.uk</a>
        </div>
      </section>

      <p class="reading-fineprint">
        These don't replace professional support. If you need someone now, the <a href="/resources">support resources page</a> has who to call.
      </p>
    </main>

    <Footer />
  </body>
</html>

<style>
  .reading-main {
    max-width: 920px;
    padding-top: 2rem;
    padding-bottom: 3.5rem;
  }

  .reading-hero {
    margin-bottom: 2.4rem;
  }

  .reading-hero h1 {
    margin: 0 0 0.6rem;
    color: var(--green-lime);
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    line-height: 1.15;
  }

  .reading-intro {
    margin: 0 0 0.8rem;
    max-width: 60ch;
    color: var(--green-light);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  /* The honesty note about how the list is built. Quieter than the intro:
     it is context, not the headline. */
  /* Lilac panel rather than a lime rule on the dark page, matching the
     Book List card below it. */
  .reading-rule {
    margin: 0;
    max-width: 62ch;
    padding: 0.8rem 1rem;
    border-left: 4px solid var(--purple);
    border-radius: 0 10px 10px 0;
    background: #f9effd;
    color: #1a1a1a;
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .reading-block {
    margin-bottom: 2.6rem;
  }

  .reading-block h2 {
    margin: 0 0 1.1rem;
    color: var(--green-lime);
    font-size: 1.35rem;
  }

  /* Topic is the outer split, format the inner one, so the topic heading has
     to win the size contest or the page reads as four equal sections. */
  /* Topic and format headings now sit inside the lilac card, so they are
     purple on light rather than lime on dark. */
  .reading-topic + .reading-topic {
    margin-top: 2rem;
    padding-top: 1.6rem;
    border-top: 1px solid rgba(105, 0, 90, 0.2);
  }

  .reading-topic-heading {
    margin: 0 0 0.3rem;
    color: var(--purple);
    font-size: 1.3rem;
  }

  .reading-topic-blurb {
    margin: 0 0 1.2rem;
    max-width: 58ch;
    color: #1a1a1a;
    opacity: 0.8;
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .reading-format-tag {
    display: inline-block;
    align-self: flex-start;
    margin-bottom: 0.4rem;
    padding: 0.14rem 0.5rem;
    border-radius: 999px;
    background: var(--purple);
    color: #ffffff;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.62rem;
    font-weight: 800;
  }

  /* ── Book List card ───────────────────────────────────────────────────
     Same card template as Mindfulness and Toolkit, in lilac: purple top
     edge, logo, eyebrow and title, then the entries underneath. */
  .deck-card-reading {
    margin: 0 0 1.6rem;
    padding: 1.5rem 1.5rem 1.6rem;
    border: none;
    border-top: 7px solid var(--purple);
    border-radius: 18px;
    background: #f9effd;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.42);
  }

  .deck-head {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-bottom: 0.9rem;
    margin-bottom: 1.3rem;
    border-bottom: 1px solid rgba(105, 0, 90, 0.25);
  }

  .deck-logo {
    width: 74px;
    height: auto;
    flex: 0 0 auto;
  }

  .deck-eyebrow {
    margin: 0;
    color: var(--purple);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.72rem;
    font-weight: 800;
  }

  .deck-series {
    margin: 0;
    color: var(--purple);
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.1;
  }

  /* Two across, each entry laid out cover-left like the phone version.
     Fixed at two rather than auto-fill: three across made each note about
     four words wide, and auto-fit stretched a lone entry across the whole
     card. */
  .reading-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    padding: 0;
    margin: 0;
  }

  /* Cover on the left, text on the right, the same shape as the phone
     layout. */
  .reading-card {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 1rem;
    padding: 1rem;
    background: #ffffff;
    border: 1px solid rgba(105, 0, 90, 0.2);
    border-radius: 12px;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .reading-card:hover {
    border-color: var(--purple);
    transform: translateY(-2px);
    box-shadow: 0 10px 22px rgba(0, 0, 0, 0.16);
  }

  /* 2:3 is the standard book cover ratio, so the frame is the right shape
     before any image arrives and the card does not jump when it loads. */
  /* Fixed size rather than full-bleed. A 2:3 cover at the card's full
     width turns every entry into a very tall column. */
  .cover-frame {
    position: relative;
    flex: 0 0 auto;
    width: 88px;
    height: 132px;
    align-self: flex-start;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.22);
  }

  /* Podcast artwork is square, not 2:3, so the frame changes shape rather
     than letterboxing a book-shaped box around it. */
  .reading-card-podcasts .cover-frame {
    width: 98px;
    height: 98px;
    border-radius: 10px;
  }

  .reading-card-podcasts .cover-fallback {
    background: linear-gradient(160deg, #10361f 0%, #071109 100%);
    border: 1px solid rgba(192, 254, 113, 0.3);
    justify-content: flex-end;
  }

  .reading-card-podcasts .cover-fallback-author {
    color: var(--green-lime);
  }

  .cover-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 0.5rem 0.45rem;
    background: linear-gradient(160deg, var(--purple) 0%, #3d0035 100%);
    text-align: left;
  }

  /* Sized for the 88px cover box. It was set for a frame roughly a third
     wider, so a long title ran outside the box. */
  .cover-fallback-title {
    color: #ffffff;
    font-size: 0.62rem;
    font-weight: 800;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .cover-fallback-author {
    color: var(--purple-light);
    font-size: 0.55rem;
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  /* Sits over the fallback. If Open Library has no cover for this ISBN the
     request 404s, onerror removes the element, and the fallback shows. */
  .cover-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* The card is white now, so the text that used to be white or lime on a
     dark card has to invert or it disappears. */
  .reading-title {
    margin: 0 0 0.2rem;
    color: var(--purple);
    font-size: 1.02rem;
    line-height: 1.3;
  }

  .reading-byline {
    margin: 0 0 0.5rem;
    color: var(--purple);
    opacity: 0.75;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .reading-note {
    margin: 0 0 0.9rem;
    color: #1a1a1a;
    opacity: 0.85;
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .reading-body {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
  }

  .reading-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: auto;
    color: var(--purple);
    font-size: 0.86rem;
    font-weight: 700;
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }

  .reading-link:hover,
  .reading-link:focus-visible {
    color: #2e0028;
    border-bottom-color: #2e0028;
  }

  .reading-link-ext {
    font-size: 0.8rem;
  }

  /* ── The ask, as Saoirse ──────────────────────────────────────────────
     Was a lilac panel with a heading and two lines in it, for an ask that is
     one sentence long. Saoirse says it instead, using the same speech-bubble
     pattern as the series pages: white bubble, thick purple border, a solid
     offset shadow instead of a soft blur, and a bordered tail pointing back
     at her. */
  .reading-ask {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    margin: 0 0 1.6rem;
  }

  .saoirse-avatar {
    flex: 0 0 auto;
    width: 78px;
    height: 78px;
    object-fit: contain;
    margin-top: 0.4rem;
    animation: saoirse-bob 3.2s ease-in-out infinite;
  }

  @keyframes saoirse-bob {
    0%, 100% { transform: translateY(0) rotate(-3deg); }
    50%      { transform: translateY(-6px) rotate(3deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .saoirse-avatar { animation: none; }
  }

  .saoirse-bubble {
    position: relative;
    flex: 1 1 auto;
    padding: 1.1rem 1.25rem;
    background: #ffffff;
    border: 3px solid var(--purple);
    border-radius: 18px;
    box-shadow: 0 8px 0 rgba(105, 0, 90, 0.18);
  }

  /* Tail pointing back at Saoirse. Two triangles so it gets a border too:
     the outer one paints the purple edge, the inner one covers it in white
     and leaves the border showing as a 3px line. */
  .saoirse-bubble::before,
  .saoirse-bubble::after {
    content: "";
    position: absolute;
    top: 24px;
    width: 0;
    height: 0;
    border-style: solid;
  }

  .saoirse-bubble::before {
    left: -16px;
    border-width: 10px 16px 10px 0;
    border-color: transparent var(--purple) transparent transparent;
  }

  .saoirse-bubble::after {
    left: -11px;
    border-width: 7px 12px 7px 0;
    border-color: transparent #ffffff transparent transparent;
  }

  .reading-ask-copy {
    margin: 0;
    color: #1a1a1a;
    font-size: 1.02rem;
    line-height: 1.5;
  }

  .reading-ask-link {
    display: inline-block;
    margin-top: 0.5rem;
    color: var(--purple) !important;
    font-weight: 700;
    text-decoration: underline;
    overflow-wrap: anywhere;
  }


  /* Sits on the dark page now rather than inside a panel, so it needs its
     own colour. */
  .reading-fineprint {
    margin: 0 0 2rem;
    max-width: 62ch;
    color: var(--green-light);
    font-size: 0.85rem;
    line-height: 1.55;
    opacity: 0.7;
  }

  .reading-fineprint a {
    color: var(--green-lime);
    font-weight: 700;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  @media (max-width: 620px) {
    .reading-main { padding-top: 1.25rem; }

    /* One per row on a phone. Two would leave each note a few words wide. */
    .reading-list { grid-template-columns: 1fr; }

    .reading-card {
      gap: 0.9rem;
      padding: 0.9rem;
    }

    .cover-frame {
      width: 78px;
      height: 117px;
    }

    .reading-card-podcasts .cover-frame {
      width: 88px;
      height: 88px;
    }

    .reading-note {
      font-size: 0.84rem;
      line-height: 1.45;
    }

    .cover-fallback-title { font-size: 0.62rem; }
    .cover-fallback-author { font-size: 0.55rem; }

    .deck-card-reading { padding: 1.1rem 1rem 1.2rem; }
    .deck-logo { width: 58px; }

    /* Matches the sizes the series pages drop Saoirse to on a phone. */
    .reading-ask { gap: 0.6rem; }
    .saoirse-avatar { width: 54px; height: 54px; }
    .saoirse-bubble { padding: 0.9rem 1rem; }
    .reading-ask-copy { font-size: 0.95rem; }
  }
</style>
