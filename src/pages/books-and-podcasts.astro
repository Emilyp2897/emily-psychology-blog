---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

// Only things Emily has actually read or listened to go on this page.
// It is a recommendations list, not a reading list scraped from somewhere,
// so an entry earns its place by someone getting something out of it.
// Add to `books` / `podcasts` / `articles` below; empty sections hide
// themselves rather than showing "coming soon" placeholders.
type Recommendation = {
  title: string;
  author: string;
  year?: string;
  /**
   * ISBN-13, no hyphens. Used to pull the cover from Open Library, which
   * publishes covers as a free service specifically for linking to.
   * Leave it off and the card falls back to a typographic cover.
   */
  isbn?: string;
  /** Where to send people. Amazon for books, the show's own page for podcasts. */
  link?: string;
  /** Emily's own note. First person. Why this one, and who it is for. */
  note: string;
};

// `default=false` matters: without it Open Library returns a blank 1x1 image
// for a cover it does not have, which would sit there as an empty grey box.
// With it, a missing cover 404s, the onerror handler fires, and the card
// falls back to the typographic cover underneath.
const coverUrl = (isbn: string) =>
  `https://covers.openlibrary.org/b/isbn/${isbn}-L.jpg?default=false`;

const books: Recommendation[] = [
  {
    title: 'Reasons to Stay Alive',
    author: 'Matt Haig',
    year: '2015',
    isbn: '9781782115083',
    link: 'https://www.amazon.co.uk/Reasons-Stay-Alive-Matt-Haig/dp/1782115080',
    note: 'Haig writes about coming through depression and anxiety in his twenties. It is short, the chapters are short, and you can pick it up and put it down, which matters when your concentration is gone. Nothing in it is advice from on high. It is someone describing what it was actually like, which is the bit I needed to read first.',
  },
  {
    title: 'The Chimp Paradox',
    author: 'Prof Steve Peters',
    year: '2012',
    isbn: '9780091935580',
    link: 'https://www.amazon.co.uk/dp/009193558X',
    note: 'A model for the part of your head that reacts before you have decided anything. Peters has worked with elite sport, and it shows: it is practical rather than abstract. If you have ever come off a pitch wondering why you behaved like that, this gives you a way to talk about it.',
  },
];

const podcasts: Recommendation[] = [
  {
    title: 'Sports Psychology Coaching',
    author: 'Eli Straw',
    link: 'https://www.successstartswithin.com/sports-psychology-podcast/',
    note: 'Short, practical episodes on the mental side of competing. Confidence, performance anxiety, trusting your training, staying composed when it matters. Straw is a mental performance coach rather than an interviewer, so it is less celebrity chat and more here is the thing to actually do this week.',
  },
];

const articles: Recommendation[] = [];

const sections = [
  { key: 'books', heading: 'Books', items: books },
  { key: 'podcasts', heading: 'Podcasts', items: podcasts },
  { key: 'articles', heading: 'Articles and essays', items: articles },
].filter((section) => section.items.length > 0);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Books & Podcasts | ${SITE_TITLE}`}
      description="Books, podcasts and articles on mental health, mental wellbeing and performance psychology. Only things that have actually been read or listened to."
    />
  </head>
  <body class="reading-page">
    <Header />

    <main class="container reading-main">
      <section class="reading-hero">
        <h1>Books &amp; Podcasts</h1>
        <p class="reading-intro">
          Things worth reading and listening to on mental health, mental wellbeing and performance psychology.
        </p>
        <p class="reading-rule">
          Everything here has actually been read or listened to. Nothing goes up because it turned up on a list somewhere. That means this page grows slowly, which is the point.
        </p>
      </section>

      {sections.map((section) => (
        <section class="reading-block" aria-labelledby={`heading-${section.key}`}>
          <h2 id={`heading-${section.key}`}>{section.heading}</h2>
          <ul class="reading-list">
            {section.items.map((item) => (
              <li class:list={["reading-card", `reading-card-${section.key}`]}>
                {/* The typographic cover sits underneath as real content, not
                    as a background image, so it is what you see if Open
                    Library is down or has no cover for this edition. */}
                <div class="cover-frame">
                  <div class="cover-fallback" aria-hidden="true">
                    <span class="cover-fallback-title">{item.title}</span>
                    <span class="cover-fallback-author">{item.author}</span>
                  </div>
                  {item.isbn && (
                    <img
                      class="cover-img"
                      src={coverUrl(item.isbn)}
                      alt={`Cover of ${item.title} by ${item.author}`}
                      loading="lazy"
                      onerror="this.remove()"
                    />
                  )}
                </div>

                <div class="reading-body">
                  <h3 class="reading-title">{item.title}</h3>
                  <p class="reading-byline">
                    {item.author}{item.year ? ` · ${item.year}` : ''}
                  </p>
                  <p class="reading-note">{item.note}</p>
                  {item.link && (
                    <a class="reading-link" href={item.link} target="_blank" rel="noopener noreferrer">
                      {section.key === 'podcasts' ? 'Listen' : 'Buy on Amazon'}
                      <span class="reading-link-ext" aria-hidden="true">↗</span>
                      <span class="visually-hidden">(opens in a new tab)</span>
                    </a>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))}

      <section class="reading-block reading-ask" aria-labelledby="heading-ask">
        <h2 id="heading-ask">Got one that helped you?</h2>
        <p>
          This list is short on purpose, and it is far too short to be useful on its own yet. If a book, podcast or article genuinely helped you, whether it is about sport or has nothing to do with sport, send it on and say what it did for you.
        </p>
        <p>
          Email <a href="mailto:emilyphelan@mindthegael.co.uk">emilyphelan@mindthegael.co.uk</a> or use the <a href="/contact-us">contact page</a>.
        </p>
        <p class="reading-fineprint">
          None of these are a substitute for professional support. If you need someone now, the <a href="/resources">support resources page</a> has who to call.
        </p>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  .reading-main {
    max-width: 920px;
    padding-top: 2rem;
    padding-bottom: 3.5rem;
  }

  .reading-hero {
    margin-bottom: 2.4rem;
  }

  .reading-hero h1 {
    margin: 0 0 0.6rem;
    color: var(--green-lime);
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    line-height: 1.15;
  }

  .reading-intro {
    margin: 0 0 0.8rem;
    max-width: 60ch;
    color: var(--green-light);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  /* The honesty note about how the list is built. Quieter than the intro:
     it is context, not the headline. */
  .reading-rule {
    margin: 0;
    max-width: 62ch;
    padding-left: 0.9rem;
    border-left: 3px solid rgba(192, 254, 113, 0.45);
    color: var(--green-light);
    opacity: 0.85;
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .reading-block {
    margin-bottom: 2.6rem;
  }

  .reading-block h2 {
    margin: 0 0 1.1rem;
    color: var(--green-lime);
    font-size: 1.35rem;
  }

  .reading-list {
    list-style: none;
    display: grid;
    gap: 1.1rem;
    padding: 0;
    margin: 0;
  }

  /* Cover on the left, text on the right. Flat dark card with a quiet edge,
     matching the simplified toolkit surfaces. */
  .reading-card {
    display: grid;
    grid-template-columns: 132px 1fr;
    gap: 1.4rem;
    align-items: start;
    padding: 1.3rem 1.4rem;
    background: #071109;
    border: 1px solid rgba(192, 254, 113, 0.18);
    border-radius: 16px;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .reading-card:hover {
    border-color: rgba(192, 254, 113, 0.45);
    transform: translateY(-2px);
  }

  /* 2:3 is the standard book cover ratio, so the frame is the right shape
     before any image arrives and the card does not jump when it loads. */
  .cover-frame {
    position: relative;
    aspect-ratio: 2 / 3;
    border-radius: 6px;
    overflow: hidden;
    box-shadow: 0 10px 22px rgba(0, 0, 0, 0.5);
  }

  /* Podcast artwork is square, not 2:3, so the frame changes shape rather
     than letterboxing a book-shaped box around it. */
  .reading-card-podcasts .cover-frame {
    aspect-ratio: 1 / 1;
    border-radius: 10px;
  }

  .reading-card-podcasts .cover-fallback {
    background: linear-gradient(160deg, #10361f 0%, #071109 100%);
    border: 1px solid rgba(192, 254, 113, 0.3);
    justify-content: flex-end;
  }

  .reading-card-podcasts .cover-fallback-author {
    color: var(--green-lime);
  }

  .cover-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 0.8rem 0.7rem;
    background: linear-gradient(160deg, var(--purple) 0%, #3d0035 100%);
    text-align: left;
  }

  .cover-fallback-title {
    color: #ffffff;
    font-size: 0.86rem;
    font-weight: 800;
    line-height: 1.22;
  }

  .cover-fallback-author {
    color: var(--purple-light);
    font-size: 0.7rem;
    font-weight: 700;
  }

  /* Sits over the fallback. If Open Library has no cover for this ISBN the
     request 404s, onerror removes the element, and the fallback shows. */
  .cover-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .reading-title {
    margin: 0 0 0.2rem;
    color: #ffffff;
    font-size: 1.18rem;
    line-height: 1.3;
  }

  .reading-byline {
    margin: 0 0 0.7rem;
    color: var(--green-lime);
    font-size: 0.85rem;
    font-weight: 700;
  }

  .reading-note {
    margin: 0 0 0.9rem;
    color: var(--green-light);
    font-size: 0.98rem;
    line-height: 1.6;
  }

  .reading-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--green-lime);
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }

  .reading-link:hover,
  .reading-link:focus-visible {
    color: #ffffff;
    border-bottom-color: #ffffff;
  }

  .reading-link-ext {
    font-size: 0.8rem;
  }

  .reading-ask {
    padding: 1.4rem 1.5rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 16px;
  }

  .reading-ask h2 {
    margin-bottom: 0.6rem;
  }

  .reading-ask p {
    margin: 0 0 0.7rem;
    max-width: 62ch;
    color: var(--green-light);
    line-height: 1.6;
  }

  .reading-ask p:last-child {
    margin-bottom: 0;
  }

  .reading-ask a {
    color: var(--green-lime);
    font-weight: 700;
  }

  .reading-ask a:hover,
  .reading-ask a:focus-visible {
    color: #ffffff;
  }

  .reading-fineprint {
    font-size: 0.88rem;
    opacity: 0.8;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  @media (max-width: 620px) {
    .reading-main { padding-top: 1.25rem; }

    /* Cover shrinks rather than stacking: a full-width book cover on a phone
       pushes the note itself below the fold. */
    .reading-card {
      grid-template-columns: 92px 1fr;
      gap: 1rem;
      padding: 1rem 1.05rem;
    }

    .cover-fallback-title { font-size: 0.72rem; }
    .cover-fallback-author { font-size: 0.62rem; }
  }
</style>
